<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Title" Color="#ECECEC"/>
    <SolidColorBrush x:Key="Border" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="BgDark" Color="#ECECEC"/>
    <SolidColorBrush x:Key="BgMedium" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="BgLight" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgMediumInvert" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="AccentColor" Color="#6C5CE7"/>
    <SolidColorBrush x:Key="AccentColorSecondary" Color="#00CCCC"/>
    <SolidColorBrush x:Key="AccentSurface" Color="#E3DFF7"/>
    <SolidColorBrush x:Key="AccentSurfaceSubtle" Color="#EFEDF9"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#993C3C43"/>
    <SolidColorBrush x:Key="Error" Color="#FF3B30"/>
    <SolidColorBrush x:Key="Warning" Color="#FF9500"/>
    <SolidColorBrush x:Key="Success" Color="#06943D"/>
</ResourceDictionary>
