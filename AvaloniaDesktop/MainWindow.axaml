<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:PlayVoice" x:Class="PlayVoice.MainWindow"
 Title="PlayVoice" Icon="/Assets/PlayVoice.ico" Width="1320" Height="840" MinWidth="960" MinHeight="640" UseLayoutRounding="True" Background="{DynamicResource BgDark}" FontFamily="{DynamicResource UiFont}" FontSize="{DynamicResource UiFontSize}" TransparencyLevelHint="Mica, AcrylicBlur, None">
 <Grid RowDefinitions="*,96">
  <Grid ColumnDefinitions="208,*">
   <Border Background="{DynamicResource BgMedium}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Padding="16,24">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="6,0,0,28"><Image Source="/Assets/PlayVoice.png" Width="30" Height="30"/><TextBlock Text="PlayVoice" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center"/></StackPanel>
     <Border DockPanel.Dock="Bottom" Classes="card" Padding="12"><StackPanel Spacing="6"><TextBlock Text="{Binding L[启动准备]}" FontWeight="SemiBold"/><TextBlock Text="{Binding Requirements}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="12"/></StackPanel></Border>
     <ListBox x:Name="Navigation" SelectedIndex="0" Background="Transparent" SelectionChanged="Navigate"><ListBoxItem><StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><Path Data="M 9,17 L 9,5 L 19,3 L 19,15 M 9,7 L 19,5 M 9,17 A 3,2 0 1 1 6,15 A 3,2 0 0 1 9,17 M 19,15 A 3,2 0 1 1 16,13 A 3,2 0 0 1 19,15" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="{Binding L[音效库]}" VerticalAlignment="Center"/></StackPanel></ListBoxItem><ListBoxItem><StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><Path Data="M 4,4 L 20,4 L 20,20 L 4,20 Z M 4,9 L 20,9 M 9,9 L 9,20" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="{Binding L[游戏预设]}" VerticalAlignment="Center"/></StackPanel></ListBoxItem><ListBoxItem><StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><Path Data="M 4,7 L 20,7 L 20,21 L 4,21 Z M 8,7 L 8,5 A 4,4 0 0 1 16,5 L 16,7" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="{Binding L[创意工坊]}" VerticalAlignment="Center"/></StackPanel></ListBoxItem><ListBoxItem><StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><Path Data="M 12,8 A 4,4 0 1 0 12,16 A 4,4 0 0 0 12,8 M 9,3 L 15,3 L 16,6 L 20,7 L 22,12 L 20,17 L 16,18 L 15,21 L 9,21 L 8,18 L 4,17 L 2,12 L 4,7 L 8,6 Z" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="{Binding L[设置]}" VerticalAlignment="Center"/></StackPanel></ListBoxItem></ListBox>
    </DockPanel>
   </Border>
   <Grid Grid.Column="1" Margin="28,24" RowDefinitions="Auto,Auto,*">
    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding PageTitle}" FontSize="28" FontWeight="SemiBold"/><Button Grid.Column="1" Classes="icon" Click="ImportAudio" ToolTip.Tip="{Binding L[导入]}" AutomationProperties.Name="{Binding L[导入]}"><Path Data="M 12,3 L 12,17 M 7,12 L 12,17 L 17,12 M 4,16 L 4,21 L 20,21 L 20,16" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button></Grid>
    <Border Grid.Row="1" IsVisible="{Binding HasNotice}" Background="{DynamicResource AccentSurface}" CornerRadius="10" Margin="0,16,0,0" Padding="12"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Notice}" TextWrapping="Wrap"/><Button Grid.Column="1" Classes="icon" Click="DismissNotice" ToolTip.Tip="{Binding L[关闭]}" AutomationProperties.Name="{Binding L[关闭]}"><Path Data="M 5,5 L 19,19 M 19,5 L 5,19" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button></Grid></Border>
    <Grid Grid.Row="2" Margin="0,20,0,0">
     <Grid x:Name="LibraryPage" ColumnDefinitions="*,320" ColumnSpacing="20">
      <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">
       <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><ComboBox x:Name="AudioPresets" ItemsSource="{Binding AudioPresetNames}" SelectedItem="{Binding ActiveAudioPresetName}" SelectionChanged="AudioPresetChanged" HorizontalAlignment="Stretch"/><Button Grid.Column="1" Classes="icon" Click="CreateAudioPreset" ToolTip.Tip="{Binding L[创建音频预设]}" AutomationProperties.Name="{Binding L[创建音频预设]}"><Path Data="M 12,4 L 12,20 M 4,12 L 20,12" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button><Button Grid.Column="2" Classes="icon" Click="RefreshLibrary" ToolTip.Tip="{Binding L[刷新]}" AutomationProperties.Name="{Binding L[刷新]}"><Path Data="M 19,8 A 8,8 0 1 0 20,15 M 19,3 L 19,8 L 14,8" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button></Grid>
       <StackPanel Grid.Row="1" Spacing="10"><TextBox Text="{Binding Search, Mode=TwoWay}" PlaceholderText="{Binding L[搜索]}"/><WrapPanel Orientation="Horizontal"><CheckBox Content="{Binding L[收藏]}" IsChecked="{Binding Favorites, Mode=TwoWay}" Margin="0,0,16,0"/><CheckBox Content="{Binding L[最近播放]}" IsChecked="{Binding Recent, Mode=TwoWay}"/></WrapPanel></StackPanel>
       <Grid Grid.Row="2"><ListBox x:Name="Sounds" ItemsSource="{Binding Tracks}" SelectionMode="Multiple,Toggle" SelectionChanged="SoundSelected" Background="Transparent"><ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10" Margin="2,4"><Button Classes="icon" Tag="{Binding}" Click="PlayRow" ToolTip.Tip="{Binding $parent[Window].DataContext.L[播放]}" AutomationProperties.Name="{Binding $parent[Window].DataContext.L[播放]}"><PathIcon Data="M 3,1 L 15,9 L 3,17 Z" Width="13" Height="16"/></Button><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="Medium"/><TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/></StackPanel><Border Grid.Column="2" Background="{DynamicResource AccentSurface}" CornerRadius="6" Padding="8,4" VerticalAlignment="Center"><TextBlock Text="{Binding Hotkey}" FontSize="11"/></Border></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="{Binding L[没有匹配的音效]}" IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" IsHitTestVisible="False"/></Grid>
      </Grid>
      <Border Grid.Column="1" Classes="card" Padding="18"><ScrollViewer><StackPanel Spacing="14">
       <TextBlock Text="{Binding L[编辑]}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedName}" TextWrapping="Wrap"/>
       <WrapPanel><Button Classes="icon" Click="Preview" ToolTip.Tip="{Binding L[试听]}" AutomationProperties.Name="{Binding L[试听]}"><Path Data="M 4,15 L 4,12 A 8,8 0 0 1 20,12 L 20,15 M 4,12 L 7,12 L 7,20 L 4,20 Z M 17,12 L 20,12 L 20,20 L 17,20 Z" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button><Button Classes="icon" Click="ToggleFavorite" Margin="8,0,0,0" ToolTip.Tip="{Binding L[收藏]}" AutomationProperties.Name="{Binding L[收藏]}"><Path Data="M 12,3 L 15,9 L 22,10 L 17,15 L 18,22 L 12,18 L 6,22 L 7,15 L 2,10 L 9,9 Z" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button><Button Classes="icon" Click="RecordHotkey" Margin="8,0,0,0" ToolTip.Tip="{Binding L[热键]}" AutomationProperties.Name="{Binding L[热键]}"><Path Data="M 3,5 L 21,5 L 21,19 L 3,19 Z M 7,9 L 8,9 M 11,9 L 12,9 M 15,9 L 16,9 M 7,13 L 8,13 M 11,13 L 17,13" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button></WrapPanel>
       <TextBlock Text="{Binding L[标签]}"/><TextBox x:Name="TagsInput" PlaceholderText="{Binding L[标签]}"/>
       <TextBlock Text="{Binding L[音量]}"/><Slider x:Name="TrackVolume" Minimum="-40" Maximum="12" Value="0"/>
       <TextBlock Text="{Binding L[波形裁剪]}"/><local:WaveformEditor Focusable="True" ToolTip.Tip="{Binding L[波形操作提示]}" x:Name="Waveform" Height="96" SelectionChanged="WaveformChanged"/>
       <TextBlock Text="{Binding L[开始时间]}"/><NumericUpDown x:Name="TrimStart" Minimum="0" Increment="0.05" FormatString="0.00"/>
       <TextBlock Text="{Binding L[结束时间]}"/><NumericUpDown x:Name="TrimEnd" Minimum="0" Increment="0.05" FormatString="0.00"/>
       <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel Spacing="6"><TextBlock Text="{Binding L[淡入]}"/><NumericUpDown x:Name="FadeIn" Minimum="0" Increment="0.05" FormatString="0.00"/></StackPanel><StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{Binding L[淡出]}"/><NumericUpDown x:Name="FadeOut" Minimum="0" Increment="0.05" FormatString="0.00"/></StackPanel></Grid>
       <Button Classes="icon" Click="SaveTrack" ToolTip.Tip="{Binding L[保存]}" AutomationProperties.Name="{Binding L[保存]}"><Path Data="M 4,3 L 17,3 L 21,7 L 21,21 L 3,21 L 3,3 Z M 7,3 L 7,9 L 16,9 L 16,3 M 7,21 L 7,14 L 17,14 L 17,21" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button>
      </StackPanel></ScrollViewer></Border>
     </Grid>
     <ScrollViewer x:Name="PresetsPage" IsVisible="False"><StackPanel Spacing="18"><Border Classes="card"><StackPanel Spacing="14"><TextBlock Text="{Binding L[游戏预设]}" FontSize="18" FontWeight="SemiBold"/><ComboBox x:Name="GamePresets" ItemsSource="{Binding GamePresetNames}" SelectedItem="{Binding ActiveGamePresetName}" SelectionChanged="GamePresetChanged" HorizontalAlignment="Stretch"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBox x:Name="PresetName" PlaceholderText="{Binding L[主题名称]}"/><Button Grid.Column="1" Classes="icon" Click="CreateGamePreset" ToolTip.Tip="{Binding L[创建游戏预设]}" AutomationProperties.Name="{Binding L[创建游戏预设]}"><Path Data="M 12,4 L 12,20 M 4,12 L 20,12" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button></Grid><TextBlock Text="{Binding L[热键]}"/><Button Click="RecordStopHotkey" Content="{Binding StopHotkey}" ToolTip.Tip="{Binding L[停止全部]}"/><TextBlock Text="{Binding L[播放模式]}"/><ComboBox x:Name="PlaybackModes" SelectionChanged="PlaybackModeChanged"/></StackPanel></Border><TextBlock Text="{Binding PresetSummary}" TextWrapping="Wrap"/></StackPanel></ScrollViewer>
     <ScrollViewer x:Name="WorkshopPage" IsVisible="False"><StackPanel Spacing="16"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBox x:Name="WorkshopSearch" PlaceholderText="{Binding L[搜索]}"/><Button Grid.Column="1" Classes="icon" Click="SearchWorkshop" ToolTip.Tip="{Binding L[搜索]}" AutomationProperties.Name="{Binding L[搜索]}"><Path Data="M 10,3 A 7,7 0 1 0 10,17 A 7,7 0 0 0 10,3 M 15,15 L 22,22" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button></Grid><TextBlock Text="{Binding SteamStatus}" TextWrapping="Wrap"/><ItemsControl x:Name="WorkshopItems"/></StackPanel></ScrollViewer>
     <TabControl x:Name="SettingsPage" IsVisible="False">
 <TabItem Header="{Binding L[声卡绑定]}"><ScrollViewer><StackPanel Spacing="18" Margin="0,16,8,0">      <Border Classes="card"><StackPanel Spacing="14"><TextBlock Text="{Binding L[声卡绑定]}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding L[物理麦克风]}"/><ComboBox x:Name="PhysicalMic" HorizontalAlignment="Stretch" SelectionChanged="DeviceChanged"/><TextBlock Text="{Binding L[物理扬声器]}"/><ComboBox x:Name="PhysicalOutput" HorizontalAlignment="Stretch" SelectionChanged="DeviceChanged"/><TextBlock Text="{Binding L[虚拟麦克风]}"/><ComboBox x:Name="VirtualMic" HorizontalAlignment="Stretch" SelectionChanged="DeviceChanged"/><TextBlock Text="{Binding L[虚拟扬声器]}"/><ComboBox x:Name="VirtualOutput" HorizontalAlignment="Stretch" SelectionChanged="DeviceChanged"/><WrapPanel><Button Classes="icon" Click="RefreshDevices" ToolTip.Tip="{Binding L[刷新]}" AutomationProperties.Name="{Binding L[刷新]}"><Path Data="M 19,8 A 8,8 0 1 0 20,15 M 19,3 L 19,8 L 14,8" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button><Button Classes="icon" Click="TestChain" Margin="8,0,0,0" ToolTip.Tip="{Binding L[测试]}" AutomationProperties.Name="{Binding L[测试]}"><Path Data="M 6,3 L 20,12 L 6,21 Z" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button></WrapPanel><CheckBox x:Name="AudioMonitor" Content="{Binding L[音频耳返]}" IsCheckedChanged="MonitorChanged"/><CheckBox x:Name="MicMonitor" Content="{Binding L[输入耳返]}" IsCheckedChanged="MonitorChanged"/><CheckBox x:Name="AutoMute" Content="{Binding L[自动闭麦]}" IsCheckedChanged="MonitorChanged"/></StackPanel></Border>
</StackPanel></ScrollViewer></TabItem>
 <TabItem Header="{Binding L[主题配色]}"><ScrollViewer><StackPanel Spacing="18" Margin="0,16,8,0">      <Border Classes="card"><StackPanel Spacing="14"><TextBlock Text="{Binding L[主题配色]}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding L[配色风格]}"/><ComboBox x:Name="SurfaceStyles" HorizontalAlignment="Stretch"/><WrapPanel><Button Classes="icon" Click="ApplyAppearance" ToolTip.Tip="{Binding L[应用]}" AutomationProperties.Name="{Binding L[应用]}"><Path Data="M 4,12 L 9,17 L 20,6" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button><Button Classes="icon" Click="ImportTheme" Margin="8,0,0,0" ToolTip.Tip="{Binding L[导入主题]}" AutomationProperties.Name="{Binding L[导入主题]}"><Path Data="M 12,21 L 12,5 M 7,10 L 12,5 L 17,10 M 4,7 L 4,3 L 20,3 L 20,7" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button><Button Classes="icon" Click="ExportTheme" Margin="8,0,0,0" ToolTip.Tip="{Binding L[导出主题]}" AutomationProperties.Name="{Binding L[导出主题]}"><Path Data="M 12,3 L 12,17 M 7,12 L 12,17 L 17,12 M 4,16 L 4,21 L 20,21 L 20,16" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button></WrapPanel><ComboBox x:Name="ThemeChoices" HorizontalAlignment="Stretch" SelectionChanged="ThemeSelected"/><ComboBox x:Name="PaletteChoices" HorizontalAlignment="Stretch" SelectionChanged="PaletteSelected"/><TextBlock Text="{Binding L[字体]}"/><TextBox x:Name="FontInput"/><TextBlock Text="{Binding L[界面字号]}"/><NumericUpDown x:Name="FontSizeInput" Minimum="11" Maximum="18" Value="13"/><TextBlock Text="{Binding L[强调色]}"/><TextBox x:Name="AccentInput" PlaceholderText="#RRGGBB"/><ComboBox x:Name="Materials" HorizontalAlignment="Stretch" SelectionChanged="MaterialSelected"/><Expander Header="{Binding L[自定义颜色]}"><StackPanel Spacing="12" Margin="0,12,0,0"><TextBlock Text="{Binding L[背景色]}"/><TextBox x:Name="BackgroundInput" PlaceholderText="#RRGGBB" MaxLength="7"/><TextBlock Text="{Binding L[前景色]}"/><TextBox x:Name="ForegroundInput" PlaceholderText="#RRGGBB" MaxLength="7"/><TextBlock Text="{Binding L[面板背景]}"/><TextBox x:Name="SurfaceInput" PlaceholderText="#RRGGBB" MaxLength="7"/><TextBlock Text="{Binding L[侧栏背景]}"/><TextBox x:Name="SidebarInput" PlaceholderText="#RRGGBB" MaxLength="7"/><TextBlock Text="{Binding L[次级文字]}"/><TextBox x:Name="SecondaryInput" PlaceholderText="#RRGGBB" MaxLength="7"/><TextBlock Text="{Binding L[边框颜色]}"/><TextBox x:Name="BorderInput" PlaceholderText="#RRGGBB" MaxLength="7"/></StackPanel></Expander><TextBlock Text="{Binding L[圆角]}"/><NumericUpDown x:Name="RadiusInput" Minimum="0" Maximum="24"/><TextBlock Text="{Binding L[控件高度]}"/><NumericUpDown x:Name="ControlHeightInput" Minimum="34" Maximum="52"/><TextBlock Text="{Binding L[列表行高]}"/><NumericUpDown x:Name="RowHeightInput" Minimum="44" Maximum="72"/><TextBlock Text="{Binding L[自定义主题]}"/><ComboBox x:Name="SavedThemes" SelectionChanged="SavedThemeSelected" HorizontalAlignment="Stretch"/><TextBlock Text="{Binding L[主题名称]}"/><TextBox x:Name="ThemeNameInput" MaxLength="80"/><WrapPanel><Button Click="SaveTheme" Content="{Binding L[保存主题]}"/><Button Click="ResetTheme" Content="{Binding L[重置外观]}" Margin="8,0,0,0"/></WrapPanel></StackPanel></Border>
     </StackPanel></ScrollViewer></TabItem>
 <TabItem Header="{Binding L[语言]}"><Border Classes="card" VerticalAlignment="Top" Margin="0,16,8,0"><StackPanel Spacing="14"><TextBlock Text="{Binding L[语言]}" FontWeight="SemiBold"/><ComboBox x:Name="LanguageChoices" HorizontalAlignment="Stretch" SelectionChanged="LanguageSelected"/></StackPanel></Border></TabItem>
 </TabControl>
    </Grid>
   </Grid>
  </Grid>
  <Border Grid.Row="1" Background="{DynamicResource BgMedium}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="24,14"><Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="24"><StackPanel Spacing="8" VerticalAlignment="Center"><TextBlock Text="{Binding NowPlaying}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/><ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="1" Height="3"/><TextBlock Text="{Binding PlaybackStatus}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Classes="icon" Click="Previous" ToolTip.Tip="{Binding L[上一首]}" AutomationProperties.Name="{Binding L[上一首]}"><PathIcon Data="M 0,0 L 2,0 L 2,16 L 0,16 Z M 15,0 L 3,8 L 15,16 Z" Width="16" Height="16"/></Button><Button Classes="icon" Click="PlayPause" ToolTip.Tip="{Binding L[播放]}" AutomationProperties.Name="{Binding L[播放]}"><PathIcon Data="M 2,0 L 15,8 L 2,16 Z" Width="16" Height="16"/></Button><Button Classes="icon" Click="Next" ToolTip.Tip="{Binding L[下一首]}" AutomationProperties.Name="{Binding L[下一首]}"><PathIcon Data="M 0,0 L 12,8 L 0,16 Z M 13,0 L 15,0 L 15,16 L 13,16 Z" Width="16" Height="16"/></Button><Button Classes="icon" Click="StopAll" ToolTip.Tip="{Binding L[停止全部]}" AutomationProperties.Name="{Binding L[停止全部]}"><PathIcon Data="M 0,0 L 14,0 L 14,14 L 0,14 Z" Width="14" Height="14"/></Button></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="6"><TextBlock Text="{Binding OutputDevice}" MaxWidth="300" TextTrimming="CharacterEllipsis"/><Slider x:Name="MasterVolume" Minimum="-40" Maximum="12" Width="220" ValueChanged="MasterChanged"/><TextBlock Text="{Binding L[输出设备]}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/></StackPanel></Grid></Border>
 </Grid>
</Window>