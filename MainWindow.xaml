<Window x:Class="PlayVoice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Playback="clr-namespace:PlayVoice.Pages.Playback"
        xmlns:Sidebar="clr-namespace:PlayVoice.Pages.Sidebar"
        xmlns:L="clr-namespace:PlayVoice.Resources.Language"
        xmlns:NotificationPanel="clr-namespace:PlayVoice.Pages.NotificationPanel"
        xmlns:LevelBar="clr-namespace:PlayVoice.Pages.LevelBar"
        Height="820" Width="1320" MinHeight="620" MinWidth="960" FontFamily="{DynamicResource UiFont}" FontSize="{DynamicResource UiFontSize13}" UseLayoutRounding="True"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent"
        MouseDown="Window_MouseDown"
        KeyDown="Window_KeyDown"
        Focusable="True"
        Title="Play Voice"
        Icon="/Resources/Style/PlayVoice.png">

    <Window.Resources><DataTemplate x:Key="SidebarItemTemplate"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="30"/><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/></StackPanel></DataTemplate></Window.Resources>
    <Border Background="{DynamicResource BgDark}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12">
      <Grid><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="82"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource BgMedium}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="132"/></Grid.ColumnDefinitions>
            <Border Background="Transparent" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0"><Border Background="{DynamicResource AccentColor}" Width="26" Height="26" CornerRadius="8"><TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentForeground}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="PlayVoice" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="{DynamicResource UiFontSize16}" Margin="10,0" VerticalAlignment="Center"/></StackPanel></Border>
            <UniformGrid Grid.Column="1" Columns="3"><Button x:Name="MinimizeButton" Content="─" Click="MinimizeButton_OnClick" Style="{StaticResource ChromeButton}"/><Button x:Name="MaximizeButton" Content="☐" Click="MaximizeButton_OnClick" Style="{StaticResource ChromeButton}"/><Button x:Name="CloseButton" Content="╳" Click="CloseButton_OnClick" Style="{StaticResource ChromeButton}"/></UniformGrid>
          </Grid>
        </Border>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="206"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Background="{DynamicResource BgMedium}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0"><DockPanel Margin="12,20,12,16">
            <Border DockPanel.Dock="Bottom" x:Name="StartupChecklistBorder" Background="{DynamicResource AccentSurfaceSubtle}" CornerRadius="10" Padding="12" Visibility="Collapsed"><Border.RenderTransform><TranslateTransform X="24"/></Border.RenderTransform><Expander Header="{L:Lan 启动准备}" Foreground="{DynamicResource TextPrimary}"><ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="StartupRequirementsPanel" Margin="0,10,0,0"/></ScrollViewer></Expander></Border>
            <Sidebar:SidebarControl x:Name="Sidebar" VerticalAlignment="Top" ItemsSource="{Binding MenuItems}" SelectedItem="{Binding SelectedMenu, Mode=TwoWay}" ItemTemplate="{StaticResource SidebarItemTemplate}"/>
          </DockPanel></Border>
          <Grid Grid.Column="1" Margin="24,20,24,16"><Frame x:Name="ContentFrame" NavigationUIVisibility="Hidden"/><NotificationPanel:NotificationPanel x:Name="NotificationPanel" Panel.ZIndex="100"/></Grid>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Background="{DynamicResource BgLight}" CornerRadius="0,0,12,12" Padding="22,12">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Playback:PlaybackTransport VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Margin="22,0" VerticalAlignment="Center"><TextBlock x:Name="ShellPlaybackState" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/><TextBlock x:Name="ShellOutputDevice" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/></StackPanel>
            <UniformGrid Grid.Column="2" Columns="3" Margin="0,0,24,0">
<StackPanel Margin="6,0" VerticalAlignment="Center"><TextBlock Text="{L:Lan 音频}" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource UiFontSize11}" Margin="0,0,0,5"/><LevelBar:LevelBar x:Name="AL" Height="4"/><LevelBar:LevelBar x:Name="AR" Height="4" Margin="0,3,0,0"/></StackPanel><StackPanel Margin="6,0" VerticalAlignment="Center"><TextBlock Text="{L:Lan 输入}" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource UiFontSize11}" Margin="0,0,0,5"/><LevelBar:LevelBar x:Name="IL" Height="4"/><LevelBar:LevelBar x:Name="IR" Height="4" Margin="0,3,0,0"/></StackPanel><StackPanel Margin="6,0" VerticalAlignment="Center"><TextBlock Text="{L:Lan 输出}" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource UiFontSize11}" Margin="0,0,0,5"/><LevelBar:LevelBar x:Name="OL" Height="4"/><LevelBar:LevelBar x:Name="OR" Height="4" Margin="0,3,0,0"/></StackPanel></UniformGrid><Button Grid.Column="3"  Click="StopAll_OnClick" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Padding="18,10" ToolTip="{L:Lan 停止全部}" AutomationProperties.Name="{L:Lan 停止全部}" Width="40"><TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="16"/></Button></Grid></Border>
        <Grid x:Name="BodyInteractionBlocker" Grid.Row="1" Panel.ZIndex="1000" Background="Transparent" Visibility="Collapsed"><ContentPresenter x:Name="BodyInteractionOverlayHost"/></Grid>
      </Grid>
    </Border>
</Window>