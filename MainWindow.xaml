<Window x:Class="PlayVoice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Playback="clr-namespace:PlayVoice.Pages.Playback"
        xmlns:Sidebar="clr-namespace:PlayVoice.Pages.Sidebar"
        xmlns:L="clr-namespace:PlayVoice.Resources.Language"
        xmlns:NotificationPanel="clr-namespace:PlayVoice.Pages.NotificationPanel"
        xmlns:LevelBar="clr-namespace:PlayVoice.Pages.LevelBar"
        Height="820" Width="1320" MinHeight="620" MinWidth="960" FontFamily="{DynamicResource UiFont}" FontSize="{DynamicResource UiFontSize13}" UseLayoutRounding="True"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent"
        MouseDown="Window_MouseDown"
        KeyDown="Window_KeyDown"
        Focusable="True"
        Title="Play Voice"
        Icon="/Resources/Style/PlayVoice.png">

    <Window.Resources><DataTemplate x:Key="SidebarItemTemplate"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="30"/><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/></StackPanel></DataTemplate></Window.Resources>
    <Border Background="{DynamicResource BgDark}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12">
      <Grid><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="Auto" MinHeight="88"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource BgMedium}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="132"/></Grid.ColumnDefinitions>
            <Border Background="Transparent" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0"><Border Background="{DynamicResource AccentColor}" Width="26" Height="26" CornerRadius="8"><TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentForeground}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="PlayVoice" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="{DynamicResource UiFontSize16}" Margin="10,0" VerticalAlignment="Center"/></StackPanel></Border>
            <UniformGrid Grid.Column="1" Columns="3"><Button x:Name="MinimizeButton" Content="─" Click="MinimizeButton_OnClick" Style="{StaticResource ChromeButton}"/><Button x:Name="MaximizeButton" Content="☐" Click="MaximizeButton_OnClick" Style="{StaticResource ChromeButton}"/><Button x:Name="CloseButton" Content="╳" Click="CloseButton_OnClick" Style="{StaticResource ChromeButton}"/></UniformGrid>
          </Grid>
        </Border>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="206"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Background="{DynamicResource BgMedium}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0"><DockPanel Margin="12,20,12,16">
            <Border DockPanel.Dock="Bottom" x:Name="StartupChecklistBorder" Background="{DynamicResource AccentSurfaceSubtle}" CornerRadius="10" Padding="12" Visibility="Collapsed"><Border.RenderTransform><TranslateTransform X="24"/></Border.RenderTransform><Expander Header="{L:Lan 启动准备}" Foreground="{DynamicResource TextPrimary}"><ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="StartupRequirementsPanel" Margin="0,10,0,0"/></ScrollViewer></Expander></Border>
            <Sidebar:SidebarControl x:Name="Sidebar" VerticalAlignment="Top" ItemsSource="{Binding MenuItems}" SelectedItem="{Binding SelectedMenu, Mode=TwoWay}" ItemTemplate="{StaticResource SidebarItemTemplate}"/>
          </DockPanel></Border>
          <Grid Grid.Column="1" Margin="24,20,24,16"><Frame x:Name="ContentFrame" NavigationUIVisibility="Hidden"/><NotificationPanel:NotificationPanel x:Name="NotificationPanel" Panel.ZIndex="100"/></Grid>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Background="{DynamicResource BgLight}" CornerRadius="0,0,12,12" Padding="22,12">
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
           <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ShellPlaybackState" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><TextBlock x:Name="ShellPlaybackStatus" Grid.Column="1" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource UiFontSize11}" Margin="12,0,0,0"/></Grid>
           <Grid Margin="0,10,0,0" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ProgressBar x:Name="ShellProgress" Minimum="0" Maximum="1" Height="3" Background="{DynamicResource Border}" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" VerticalAlignment="Center"><ProgressBar.Template><ControlTemplate TargetType="ProgressBar"><Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2"/></Border></ControlTemplate></ProgressBar.Template></ProgressBar><TextBlock x:Name="ShellTime" Grid.Column="1" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource UiFontSize11}" Margin="12,0,0,0"/></Grid>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0"><Playback:PlaybackTransport/><Border Width="1" Height="18" Background="{DynamicResource Border}" Margin="14,0"/><Button Click="StopAll_OnClick" Style="{StaticResource TransportButton}" ToolTip="{L:Lan 停止全部}" AutomationProperties.Name="{L:Lan 停止全部}"><Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button></StackPanel>
          <Grid Grid.Column="2" HorizontalAlignment="Right" Width="260" Margin="24,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
           <Button x:Name="ShellDevice" Style="{StaticResource ChromeButton}" Click="ShellDevice_Click" HorizontalContentAlignment="Left" Padding="0" MinHeight="24" AutomationProperties.Name="{L:Lan 输出设备}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/><TextBlock x:Name="ShellOutputDevice" Grid.Column="1" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource UiFontSize11}" VerticalAlignment="Center"/></Grid></Button>
           <Button Grid.Column="1" Click="ShellDevice_Click" Style="{StaticResource TransportButton}" Width="28" Height="28" ToolTip="{L:Lan 声卡绑定}" AutomationProperties.Name="{L:Lan 声卡绑定}"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"/></Button>
           <UniformGrid Grid.Row="1" Grid.ColumnSpan="2" Columns="3" Margin="0,4,0,0">
<StackPanel Margin="0,0,12,0"><TextBlock Text="{L:Lan 音效电平}" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource UiFontSize10}" Margin="0,0,0,4"/><Border Background="{DynamicResource Border}" CornerRadius="2"><StackPanel><LevelBar:LevelBar x:Name="AL" Height="5"/><LevelBar:LevelBar x:Name="AR" Height="5" Margin="0,2,0,0"/></StackPanel></Border></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="{L:Lan 麦克风电平}" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource UiFontSize10}" Margin="0,0,0,4"/><Border Background="{DynamicResource Border}" CornerRadius="2"><StackPanel><LevelBar:LevelBar x:Name="IL" Height="5"/><LevelBar:LevelBar x:Name="IR" Height="5" Margin="0,2,0,0"/></StackPanel></Border></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="{L:Lan 输出电平}" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource UiFontSize10}" Margin="0,0,0,4"/><Border Background="{DynamicResource Border}" CornerRadius="2"><StackPanel><LevelBar:LevelBar x:Name="OL" Height="5"/><LevelBar:LevelBar x:Name="OR" Height="5" Margin="0,2,0,0"/></StackPanel></Border></StackPanel></UniformGrid></Grid>
         </Grid>
        </Border>
        <Grid x:Name="BodyInteractionBlocker" Grid.Row="1" Panel.ZIndex="1000" Background="Transparent" Visibility="Collapsed"><ContentPresenter x:Name="BodyInteractionOverlayHost"/></Grid>
      </Grid>
    </Border>
</Window>