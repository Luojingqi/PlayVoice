<Page x:Class="PlayVoice.Pages.Preset.PresetPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PlayVoice.Pages.Preset"
      xmlns:L="clr-namespace:PlayVoice.Resources.Language"
      xmlns:TransparentAndBottomLineListBox="clr-namespace:PlayVoice.Pages.TransparentAndBottomLineListBox"
      mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Style/Button.xaml"/>
                <ResourceDictionary Source="/Resources/Style/PageBox.xaml"/>
                <ResourceDictionary Source="/Resources/Style/ListBox.xaml"/>
                <ResourceDictionary Source="/Resources/Style/ComboBox.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0">
            <Grid>
                <ListBox Style="{StaticResource TransparentAndBottomLineListBoxStyle}"
                         TransparentAndBottomLineListBox:ListBoxHelper.LinePosition="Top"
                         x:Name="TopButtonListBox"/>
                <Canvas Panel.ZIndex="10">
                    <Grid Canvas.Right="10"
                          Canvas.Top="3">
                        <ComboBox x:Name="FunctionPresetComboBox"
                                  Style="{StaticResource TransparentComboBoxStyle}"
                                  DisplayMemberPath="DisplayName"
                                  Background="{DynamicResource BgDark}"
                                  Width="130"
                                  Height="32.5"
                                  ToolTip="{L:Lan 游戏预设}"/>
                        <TextBlock Text="▼"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontSize="9"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                    </Grid>
                </Canvas>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="10,13,10,0">
            <Grid>
                <Frame x:Name="Frame0"/>
                <Border BorderBrush="{DynamicResource AccentColor}" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Background="{DynamicResource BgLight}"
                        Padding="10"
                        x:Name="Frame1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="5*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,24" VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Frame Grid.Column="0"
                                    HorizontalAlignment="Right"
                                    x:Name="CreateAudioPresetPageFrame"
                                    Margin="0,0,12,0"/>
                            <Frame Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    x:Name="CreateFunctionPresetPageFrame"
                                    Margin="12,0,0,0"/>
                        </Grid>
                        <Frame Grid.Row="1" 
                                x:Name="UploadPresetPageFrame"
                                VerticalAlignment="Top"/>
                    </Grid>
                </Border>
                <Border x:Name="Frame2"
                        BorderBrush="{DynamicResource AccentColor}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Background="{DynamicResource BgLight}"
                        Padding="10">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Frame Grid.Column="0"
                               x:Name="DeleteAudioPresetPageFrame"
                               HorizontalAlignment="Right"
                               Margin="0,0,12,0"/>
                        <Frame Grid.Column="1"
                               x:Name="DeleteFunctionPresetPageFrame"
                               HorizontalAlignment="Left"
                               Margin="12,0,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
