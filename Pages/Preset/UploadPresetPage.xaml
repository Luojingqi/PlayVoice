<Page x:Class="PlayVoice.Pages.Preset.UploadPresetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:L="clr-namespace:PlayVoice.Resources.Language"
    xmlns:DropDownList="clr-namespace:PlayVoice.Pages.DropDownList"
    xmlns:HorizontalList="clr-namespace:PlayVoice.Pages.HorizontalList"
    xmlns:Workshop="clr-namespace:PlayVoice.Pages.Workshop"
    xmlns:Loading="clr-namespace:PlayVoice.Pages.Loading"
    mc:Ignorable="d" >

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Style/ListBox.xaml"/>
                <ResourceDictionary Source="/Resources/Style/Import.xaml"/>
                <ResourceDictionary Source="/Resources/Style/TrashCan.xaml"/>
                <ResourceDictionary Source="/Resources/Style/Upload.xaml"/>
                <ResourceDictionary Source="/Resources/Style/Drag.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
    <Border x:Name="OuterLayerBorder" Background="{DynamicResource BgMedium}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="24" VerticalAlignment="Top">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="ContentGrid"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="{L:Lan 上传到创意工坊}" FontSize="{DynamicResource UiFontSize20}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,24"/>
       <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
        <StackPanel>
         <DropDownList:DropDownList x:Name="PresetComboBox" Header="{L:Lan 音频预设}" DropDownWidth="200" Height="38" Margin="0,0,0,16"/>
         <TextBlock Text="{L:Lan 为你的资源命名}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
         <TextBox x:Name="ResourceNameInputTextBox" Style="{StaticResource StudioInput}" AutomationProperties.Name="{L:Lan 为你的资源命名}" Margin="0,0,0,16"/>
         <TextBlock Text="{L:Lan 为你的资源添加描述}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
         <TextBox x:Name="ResourceDescriptionInputTextBox" Style="{StaticResource StudioInput}" Height="140" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{L:Lan 为你的资源添加描述}" Margin="0,0,0,16"/>
         <HorizontalList:HorizontalList x:Name="TabListBox" Header="{L:Lan 标签}" DropDownWidth="240" Height="38" SelectionMode="Multiple"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
         <DropDownList:DropDownList x:Name="VisibleComboBox" Header="{L:Lan 可见}" DropDownWidth="130" Height="38" Margin="0,0,0,16"/>
         <Border Width="220" Height="220" Background="{DynamicResource BgDark}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
          <Grid>
           <ListBox x:Name="ImageButton" Background="Transparent" BorderThickness="0" Style="{StaticResource HorizontalButtonGroupStyle}">
            <ListBoxItem Width="218" Height="218" Style="{StaticResource GroupButtonItemStyle}" ToolTip="{L:Lan 放入预览图}" AutomationProperties.Name="{L:Lan 放入预览图}">
             <TextBlock Text="&#xE91B;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="{DynamicResource TextSecondary}"/>
            </ListBoxItem>
           </ListBox>
           <Image x:Name="BgImage" Stretch="UniformToFill" Visibility="Collapsed"/>
           <Button x:Name="ImageCloseButton" Visibility="Collapsed" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource ChromeButton}" Width="30" Height="30" MinHeight="30" Padding="0" Margin="8" VerticalAlignment="Top" HorizontalAlignment="Right" ToolTip="{L:Lan 删除}" AutomationProperties.Name="{L:Lan 删除}"/>
          </Grid>
         </Border>
         <TextBlock Text="{L:Lan 预览图要求}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource UiFontSize11}" Margin="0,10,0,0"/>
        </StackPanel>
       </Grid>
      </Grid>
      <Grid Grid.Row="1" Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ListBox x:Name="ConfirmButton" Grid.Column="1" Style="{StaticResource HorizontalButtonGroupStyle}" Width="44" Height="40">
        <ListBoxItem Style="{StaticResource GroupButtonItemStyle}" ToolTip="{L:Lan 上传到创意工坊}" AutomationProperties.Name="{L:Lan 上传到创意工坊}"><TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource AccentColor}"/></ListBoxItem>
       </ListBox>
       <StackPanel Margin="0,0,16,0" VerticalAlignment="Center"><TextBlock x:Name="ProgressText" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource UiFontSize12}"/><Border x:Name="ProgressBarBorder" Height="2" Background="Transparent" Margin="0,8,0,0"><Border x:Name="ProgressFill" Background="{DynamicResource AccentColor}" RenderTransformOrigin="0,0.5"><Border.RenderTransform><ScaleTransform x:Name="ProgressScale" ScaleX="0"/></Border.RenderTransform></Border></Border></StackPanel>
      </Grid>
      <Frame x:Name="LoadingPageFrame" Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Grid>
    </Border>
    <Border x:Name="EditPanel" Visibility="Collapsed" Margin="10"
            Background="{DynamicResource BgLight}" BorderBrush="{DynamicResource AccentColor}"
            BorderThickness="1" CornerRadius="6" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="10,3,10,12">
                <TextBlock Text="{L:Lan 编辑作品}" Style="{StaticResource TextBlockMedium}" FontSize="{DynamicResource UiFontSize16}" TextAlignment="Center"/>
                <TextBlock x:Name="EditTitle" Style="{StaticResource TextBlockLight}" TextTrimming="CharacterEllipsis" TextAlignment="Center" FontSize="{DynamicResource UiFontSize13}" Margin="0,5,0,0"/>
            </StackPanel>
            <Grid Grid.Row="1" x:Name="EditFields">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,12,0">
                    <StackPanel>
                        <Grid Width="150" Height="150" HorizontalAlignment="Center">
                            <Rectangle Stroke="{DynamicResource AccentColor}" StrokeThickness="2" StrokeDashArray="4 2"
                                       RadiusX="5" RadiusY="5" Fill="Transparent"/>
                            <Image x:Name="EditCoverImage" Margin="7" Stretch="Uniform"/>
                        </Grid>
                        <ListBox x:Name="EditCoverActions" Style="{StaticResource HorizontalButtonGroupStyle}"
                                 HorizontalAlignment="Center" Margin="0,8,0,0" Height="32.5" Tag="Uniform"
                                 SelectionChanged="EditAction_SelectionChanged">
                            <ListBoxItem Style="{StaticResource GroupButtonItemStyle}" Tag="Cover" Padding="10,0">
                                <TextBlock Text="{L:Lan 更换封面}" Style="{StaticResource TextBlockLight}" FontSize="{DynamicResource UiFontSize13}"/>
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource GroupButtonItemStyle}" Tag="RestoreCover" Padding="10,0">
                                <TextBlock Text="{L:Lan 恢复原封面}" Style="{StaticResource TextBlockLight}" FontSize="{DynamicResource UiFontSize13}"/>
                            </ListBoxItem>
                        </ListBox>
                        <TextBlock Text="{L:Lan 简介}" Style="{StaticResource TextBlockMedium}" FontSize="{DynamicResource UiFontSize14}" Margin="0,10,0,5"/>
                        <ListBox Style="{StaticResource HorizontalButtonGroupStyle}" Tag="Uniform" Height="98">
                            <ListBoxItem Style="{StaticResource GroupInputItemStyle}" Height="92" VerticalContentAlignment="Stretch">
                                <TextBox x:Name="EditDescription" Style="{StaticResource GroupTextBoxStyle}"
                                         Tag="{L:Lan 为你的资源添加描述}" TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                         FontSize="{DynamicResource UiFontSize13}" TextChanged="EditField_Changed"/>
                            </ListBoxItem>
                        </ListBox>
                        <HorizontalList:HorizontalList x:Name="EditTagsListBox" Header="{L:Lan 标签}"
                                                       DropDownWidth="205" ListBoxFontSize="12" Height="37.5" SelectionMode="Multiple"/>
                        <TextBlock x:Name="EditOtherTags" Style="{StaticResource TextBlockLight}" FontSize="{DynamicResource UiFontSize12}"
                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="13.5,3,0,0"/>
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,8">
                        <ListBox x:Name="EditTrackActions" Style="{StaticResource HorizontalButtonGroupStyle}"
                                 Height="32.5" Margin="0,0,8,0" SelectionChanged="EditAction_SelectionChanged">
                            <ListBoxItem Style="{StaticResource GroupButtonItemStyle}" Tag="SelectAll" Padding="5,0" ToolTip="{L:Lan 全选}"
                                         AutomationProperties.Name="{L:Lan 全选}">
                                <Grid>
                                    <Ellipse Width="19" Height="19" Stroke="{DynamicResource AccentColor}" StrokeThickness="1.5" Fill="Transparent"/>
                                    <Ellipse x:Name="EditSelectAllDot" Width="8" Height="8" Fill="{DynamicResource AccentColor}" Visibility="Collapsed"/>
                                </Grid>
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource GroupButtonItemStyle}" Tag="Add" Padding="6.5" ToolTip="{L:Lan 添加音频}"
                                         AutomationProperties.Name="{L:Lan 添加音频}">
                                <Image Source="{StaticResource ImportIcon}"/>
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource GroupButtonItemStyle}" Tag="Remove" Padding="6.5,4.5" ToolTip="{L:Lan 移除所选}"
                                         AutomationProperties.Name="{L:Lan 移除所选}">
                                <Image Source="{StaticResource TrashCanIcon}"/>
                            </ListBoxItem>
                        </ListBox>
                        <ListBox x:Name="EditSortActions" Style="{StaticResource HorizontalButtonGroupStyle}"
                                 Height="32.5" SelectionChanged="EditAction_SelectionChanged">
                            <ListBoxItem Style="{StaticResource GroupButtonItemStyle}" Tag="SortAscending" Padding="10,0">
                                <TextBlock Text="{L:Lan 按名称升序}" Style="{StaticResource TextBlockLight}" FontSize="{DynamicResource UiFontSize13}"/>
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource GroupButtonItemStyle}" Tag="SortDescending" Padding="10,0">
                                <TextBlock Text="{L:Lan 按名称降序}" Style="{StaticResource TextBlockLight}" FontSize="{DynamicResource UiFontSize13}"/>
                            </ListBoxItem>
                        </ListBox>
                    </WrapPanel>
                    <Grid Grid.Row="1" Margin="0,0,3,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="2" Text="{L:Lan 名称}" Style="{StaticResource TextBlockMedium}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{L:Lan 时长}" Style="{StaticResource TextBlockMedium}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="{L:Lan 大小}" Style="{StaticResource TextBlockMedium}" HorizontalAlignment="Center"/>
                    </Grid>
                    <ListBox x:Name="EditTrackList" Grid.Row="2" SelectionMode="Extended" AllowDrop="True"
                             Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonDown="EditTrackList_MouseDown"
                             SelectionChanged="EditTrackList_SelectionChanged" MouseMove="EditTrackList_MouseMove"
                             DragOver="EditTrackList_DragOver" DragLeave="EditTrackList_DragLeave" Drop="EditTrackList_Drop">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ScrollViewer x:Name="PART_ScrollViewer" Focusable="False" Background="{TemplateBinding Background}"
                                              Padding="{TemplateBinding Padding}" CanContentScroll="True">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Height" Value="Auto"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,5.5"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid>
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="1" CornerRadius="3" IsHitTestVisible="False"/>
                                                <Border x:Name="RowHoverBorder" BorderBrush="{DynamicResource AccentColorSecondary}"
                                                        BorderThickness="1" CornerRadius="3" Opacity="0" IsHitTestVisible="False"/>
                                                <ContentPresenter/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <EventTrigger RoutedEvent="Mouse.MouseEnter">
                                                    <BeginStoryboard><Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="RowHoverBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                                    </Storyboard></BeginStoryboard>
                                                </EventTrigger>
                                                <EventTrigger RoutedEvent="Mouse.MouseLeave">
                                                    <BeginStoryboard><Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="RowHoverBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                    </Storyboard></BeginStoryboard>
                                                </EventTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSurface}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="32.5" Margin="0,0,3,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <ListBox x:Name="EditTrackSelector" Style="{StaticResource HorizontalButtonGroupStyle}"
                                             SelectionChanged="EditTrackSelector_SelectionChanged" HorizontalAlignment="Left">
                                        <ListBoxItem Style="{StaticResource GroupButtonItemStyle}" Padding="5,0"
                                                     AutomationProperties.Name="{Binding Resource.Name}">
                                            <Grid>
                                                <Ellipse Width="19" Height="19" Stroke="{DynamicResource AccentColor}" StrokeThickness="1.5" Fill="Transparent"/>
                                                <Ellipse x:Name="EditSelectionDot" Width="8" Height="8" Fill="{DynamicResource AccentColor}" Visibility="Collapsed"/>
                                            </Grid>
                                        </ListBoxItem>
                                    </ListBox>
                                    <Border Grid.Column="1" x:Name="EditDragHandle" Background="Transparent" Width="30"
                                            Margin="0,0,10,0" Padding="10,0" Cursor="SizeNS"
                                            PreviewMouseLeftButtonDown="EditDragHandle_MouseDown">
                                        <Image Source="{StaticResource DragIcon}"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Resource.Name}" Style="{StaticResource TextBlockLight}" FontSize="{DynamicResource UiFontSize13}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Resource.Name}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding DurationText}" Style="{StaticResource TextBlockLight}" FontSize="{DynamicResource UiFontSize13}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0"/>
                                    <TextBlock Grid.Column="4" Text="{Binding SizeText}" Style="{StaticResource TextBlockLight}" FontSize="{DynamicResource UiFontSize13}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="EditSelectionDot" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Canvas x:Name="EditDragOverlay" Grid.Row="2" IsHitTestVisible="False" ClipToBounds="True">
                        <Border x:Name="EditInsertionLine" Height="3" Background="{DynamicResource AccentColor}" CornerRadius="1.5" Visibility="Collapsed"/>
                    </Canvas>
                </Grid>
            </Grid>
            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <TextBlock x:Name="EditSummary" Style="{StaticResource TextBlockMedium}" FontSize="{DynamicResource UiFontSize13}" TextWrapping="Wrap"/>
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Workshop:CircularProgressBar x:Name="EditProgress" Width="36" Height="36" Margin="0,0,10,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="EditStatus" Grid.Column="1" Style="{StaticResource TextBlockLight}" FontSize="{DynamicResource UiFontSize13}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
            <ListBox x:Name="EditPublishActions" Grid.Row="3" Style="{StaticResource HorizontalButtonGroupStyle}"
                     Tag="Uniform" HorizontalAlignment="Right" Height="32.5" Margin="0,8,0,0"
                     SelectionChanged="EditAction_SelectionChanged">
                <ListBoxItem x:Name="EditCancelButton" Style="{StaticResource GroupButtonItemStyle}" Tag="Cancel" Padding="15,0" ToolTip="{L:Lan 取消}" AutomationProperties.Name="{L:Lan 取消}">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextPrimary}"/>
                </ListBoxItem>
                <ListBoxItem x:Name="EditPublishButton" Style="{StaticResource GroupButtonItemStyle}" Tag="Publish" Padding="12,0" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource UploadIcon}" Width="17" Height="17" Margin="0,0,6,0"/>
                        <TextBlock Text="{L:Lan 发布更新}" Style="{StaticResource TextBlockLight}" FontSize="{DynamicResource UiFontSize13}" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </Grid>
    </Border>
    </Grid>
</Page>
