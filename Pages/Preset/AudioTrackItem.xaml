<UserControl x:Class="PlayVoice.Pages.Preset.AudioTrackItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:L="clr-namespace:PlayVoice.Resources.Language"
             xmlns:AudioVolumeSlider="clr-namespace:PlayVoice.Pages.AudioVolumeSlider"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Style/Drag.xaml"/>
                <ResourceDictionary Source="/Resources/Style/ListBox.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="MarkedVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="RowBorder" 
            Background="Transparent"
            Margin="0,2"
            Padding="8" MinHeight="54"
            PreviewMouseLeftButtonDown="RowBorder_PreviewMouseLeftButtonDown">



        <Grid>
            <Border BorderBrush="{DynamicResource Border}" 
                    BorderThickness="1" 
                    CornerRadius="8"
                    IsHitTestVisible="False"/>

            <Border x:Name="HoverBorder" 
                    BorderBrush="{DynamicResource AccentColorSecondary}" 
                    BorderThickness="1" 
                    CornerRadius="8"
                    Opacity="0" 
                    IsHitTestVisible="False"/>

            <Rectangle x:Name="FillBackground" 
                       Fill="{DynamicResource AccentColor}" 
                       Opacity="0.08"
                       RadiusX="3" RadiusY="3"
                       RenderTransformOrigin="0,0">
                <Rectangle.RenderTransform>
                    <ScaleTransform x:Name="BackgroundScale" ScaleX="0" ScaleY="1"/>
                </Rectangle.RenderTransform>
            </Rectangle>

            <Canvas x:Name="RippleCanvas"
                    ClipToBounds="True"
                    IsHitTestVisible="False"
                    SizeChanged="RippleCanvas_SizeChanged"/>

            <Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="0"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Column="0"
                            Style="{StaticResource HorizontalButtonGroupStyle}"
                            x:Name="CheckBoxListBox">
                        <ListBoxItem Style="{StaticResource GroupButtonItemStyle}" Padding="5,0">
                            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Ellipse Width="19" Height="19"
                                        Stroke="{DynamicResource AccentColor}"
                                        Fill="Transparent"
                                        StrokeThickness="1.5"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"/>
                                <Ellipse Width="8" Height="8"
                                        Fill="{DynamicResource AccentColor}"
                                        x:Name="SelectCenterPoint"
                                         Visibility="{Binding Marked, Converter={StaticResource MarkedVisibilityConverter}}"/>
                            </Grid>
                        </ListBoxItem>
                    </ListBox>

                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="DragHandle"
                                Background="Transparent" Grid.Column="0"
                                PreviewMouseLeftButtonDown="DragHandle_MouseDown"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="30"
                                Margin="0,0,10,0"
                                Padding="10"
                                Cursor="SizeNS">
                            <Image Source="{StaticResource DragIcon}"/>
                        </Border>
                        <Button x:Name="RowPlayButton" Grid.Column="1" Click="RowPlay_Click" Style="{StaticResource ChromeButton}" Padding="6" Margin="0,0,6,0" ToolTip="{L:Lan 暂停或继续}" AutomationProperties.Name="{L:Lan 暂停或继续}"><TextBlock x:Name="RowPlayIcon" FontFamily="Segoe MDL2 Assets" Text="&#xE768;" Foreground="{DynamicResource AccentColor}"/></Button>
                        <TextBlock Text="{Binding Header}" ToolTip="{Binding Header}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Grid.Column="2"/>
                    </Grid>

                    <AudioVolumeSlider:AudioVolumeSlider 
                                        Grid.Column="2"
                                        x:Name="VolumeSlider" Visibility="Collapsed"
                                        Value="{Binding VolumeSliderValue, Mode=TwoWay}"/>
                    <TextBlock Grid.Column="3" Text="{Binding SubHeader0}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"  Width="60" Margin="5,0"/>
                    <TextBlock Visibility="Collapsed" Grid.Column="4" Text="{Binding SubHeader1}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"  Width="60" Margin="5,0"/>
                    <ListBox Grid.Column="5"
                            Style="{StaticResource HorizontalButtonGroupStyle}"
                            x:Name="KeyboardKeyListBox"
                            Width="96">
                        <ListBoxItem Style="{StaticResource GroupInputItemStyle}">
                            <TextBox Tag="{L:Lan 输入按键}"
                                     Text="{Binding Hotkey}"
                                     x:Name="KeyboardKeyInputTextBox"
                                     Style="{StaticResource GroupTextBoxStyle}"
                                     GotFocus="KeyboardKeyInputTextBox_GotFocus"
                                     LostFocus="KeyboardKeyInputTextBox_LostFocus"
                                     InputMethod.IsInputMethodEnabled="False"/>
                        </ListBoxItem>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
