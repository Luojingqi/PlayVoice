<Window x:Class="PlayVoice.Pages.Preset.UserGeneratedContentAgreementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:L="clr-namespace:PlayVoice.Resources.Language"
        Width="720" Height="620"
        MinWidth="520" MinHeight="420"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="Transparent">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Style/Button.xaml"/>
                <ResourceDictionary Source="/Resources/Style/ListBox.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource BgDark}"
            BorderBrush="{DynamicResource BgLight}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="54"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource Title}"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="{L:Lan PlayVoice UGC 上传与 Steam 创意工坊服务协议}"
                               Margin="12,0,45,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentColor}"
                               FontFamily="{StaticResource FontLight}"/>
                    <Button Content="╳"
                            Width="40"
                            HorizontalAlignment="Right"
                            Style="{StaticResource CloseButtonStyle}"
                            Click="CloseButton_OnClick"/>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="18,16,18,8"
                    Padding="14"
                    Background="{DynamicResource BgMedium}"
                    BorderBrush="{DynamicResource AccentColor}"
                    BorderThickness="1"
                    CornerRadius="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="AgreementTextBlock"
                               Style="{StaticResource TextBlockLight}"
                               FontSize="13"
                               LineHeight="21"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>

            <ListBox Grid.Row="2"
                     x:Name="ActionListBox"
                     Width="200"
                     Height="32"
                     Tag="Uniform"
                     VerticalAlignment="Center"
                     Style="{StaticResource HorizontalButtonGroupStyle}"
                     SelectionChanged="ActionListBox_SelectionChanged">
                <ListBoxItem Style="{StaticResource GroupButtonItemStyle}">
                    <TextBlock Text="{L:Lan 拒绝}" Style="{StaticResource TextBlockLight}"/>
                </ListBoxItem>
                <ListBoxItem Style="{StaticResource GroupButtonItemStyle}">
                    <TextBlock Text="{L:Lan 同意}" Style="{StaticResource TextBlockLight}"/>
                </ListBoxItem>
            </ListBox>
        </Grid>
    </Border>
</Window>
