<Page x:Class="PlayVoice.Pages.Preset.CreatePresetPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PlayVoice.Pages.Preset"
      xmlns:L="clr-namespace:PlayVoice.Resources.Language"
      mc:Ignorable="d" >

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Style/ListBox.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>


    <Border HorizontalAlignment="Stretch" VerticalAlignment="Top"
                Background="{DynamicResource AccentSurfaceSubtle}" BorderBrush="{DynamicResource Border}"
                BorderThickness="1" 
                CornerRadius="12"
                Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource TextBlockMedium}"
                            Grid.Row="0"
                            Text="{L:Lan 创建新音频预设}"
                            FontSize="{DynamicResource UiFontSize18}"
                            Margin="0,0,0,10"
                            TextAlignment="Left"/>
            <ListBox Grid.Row="1"
                        Margin="0,5"
                        Width="260" HorizontalAlignment="Left"
                        Height="38"
                        Style="{StaticResource HorizontalButtonGroupStyle}">
                <ListBoxItem Style="{StaticResource GroupInputItemStyle}">
                    <TextBox Tag="{L:Lan 输入音频预设名称}"
                                 x:Name="PresetNameInputTextBox"
                                 Style="{StaticResource GroupTextBoxStyle}"/>
                </ListBoxItem>
            </ListBox>
            <ListBox Tag="Uniform"
                    Width="120" HorizontalAlignment="Left"
                    Grid.Row="2"
                    Margin="0,5"
                    Style="{StaticResource HorizontalButtonGroupStyle}"
                    x:Name="ButtonGroupListBox">
                <ListBoxItem Style="{StaticResource GroupButtonItemStyle}" ToolTip="{L:Lan 确认}" AutomationProperties.Name="{L:Lan 确认}">
                    <TextBlock Text="&#xE8FB;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextPrimary}"/>
                </ListBoxItem>
            </ListBox>
        </Grid>
    </Border>
</Page>
