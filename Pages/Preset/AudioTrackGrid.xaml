<Page x:Class="PlayVoice.Pages.Preset.AudioTrackGrid"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:PlayVoice.Pages.Preset"
      xmlns:volume="clr-namespace:PlayVoice.Pages.AudioVolumeSlider"
      xmlns:L="clr-namespace:PlayVoice.Resources.Language"
      mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Style/ListBox.xaml"/>
                <ResourceDictionary Source="/Resources/Style/ComboBox.xaml"/>
                <ResourceDictionary Source="/Resources/Style/TrashCan.xaml"/>
                <ResourceDictionary Source="/Resources/Style/Import.xaml"/>
                <ResourceDictionary Source="/Resources/Style/Upload.xaml"/>
                <ResourceDictionary Source="/Resources/Style/Copy.xaml"/>
                <ResourceDictionary Source="/Resources/Style/Paste.xaml"/>
                <ResourceDictionary Source="/Resources/Style/Folder.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="PlaybackModeItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource GroupButtonItemStyle}">
                <Style.Triggers><Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSurface}"/>
                </Trigger></Style.Triggers>
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource StudioButton}"/>
            <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/></Style>
            <Style TargetType="Expander"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/></Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource StudioInput}"/>
        </ResourceDictionary>
    </Page.Resources>

    <Border BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="12"
            Background="Transparent"
            Padding="20">

        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,22">
                <TextBlock Text="{L:Lan 音效库}" FontSize="{DynamicResource UiFontSize28}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                <WrapPanel>
                    <TextBox x:Name="LibrarySearch" Width="300" MinHeight="38" Padding="8,4" Margin="0,0,12,0"
                             ToolTip="{L:Lan 搜索名称或标签}" AutomationProperties.Name="{L:Lan 搜索名称或标签}" TextChanged="LibraryFilterChanged"/>
                    <CheckBox x:Name="FavoritesFilter" Content="{L:Lan 收藏}" Margin="0,0,12,0" VerticalAlignment="Center" Checked="LibraryFilterChanged" Unchecked="LibraryFilterChanged"/>
                    <CheckBox x:Name="RecentFilter" Content="{L:Lan 最近播放}" VerticalAlignment="Center" Checked="LibraryFilterChanged" Unchecked="LibraryFilterChanged"/>
                </WrapPanel>
            </StackPanel>
            <Border Visibility="Collapsed" DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border}" Padding="0,10,0,0">
                <StackPanel>
                    <TextBlock x:Name="OutputStatus" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"/>
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock x:Name="PlaybackStatus" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{DynamicResource TextPrimary}"/>
                        <Button  Padding="12,6" Click="StopLibraryAudio" ToolTip="{L:Lan 停止全部}" AutomationProperties.Name="{L:Lan 停止全部}" Width="40"><TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="16"/></Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Expander x:Name="LibraryInspector" DockPanel.Dock="Right" Header="{L:Lan 编辑}" ExpandDirection="Left" IsExpanded="True" Margin="20,0,0,12">
                <StackPanel x:Name="LibraryEditor" Width="240" IsEnabled="{Binding Library.HasSelection}" Margin="8">
                    <TextBlock Text="{Binding Library.SelectedName}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,16"/>
                    <CheckBox IsChecked="{Binding Library.IsFavorite}" Content="{L:Lan 收藏}" Margin="0,0,0,12"/>
                    <TextBlock Text="{L:Lan 标签}" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBox Text="{Binding Library.TagsText, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" Padding="6" Margin="0,6,0,12" ToolTip="{L:Lan 标签以逗号分隔}" AutomationProperties.Name="{L:Lan 标签}"/>
                    <TextBlock Text="{L:Lan 音量}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/><volume:AudioVolumeSlider Value="{Binding Library.Selected.VolumeSliderValue, Mode=TwoWay}" Margin="0,0,0,16"/>
                    <Button Style="{StaticResource PrimaryButton}"  Padding="8" Command="{Binding Library.SaveSelectedCommand}" Margin="0,0,0,12" ToolTip="{L:Lan 保存所选}" AutomationProperties.Name="{L:Lan 保存所选}" Width="40"><TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="16"/></Button>
                    <Button  Padding="8" Click="PreviewLibraryAudio" Margin="0,0,0,8" ToolTip="{L:Lan 独立试听}" AutomationProperties.Name="{L:Lan 独立试听}" Width="40"><TextBlock Text="&#xE7F5;" FontFamily="Segoe MDL2 Assets" FontSize="16"/></Button>
                    <Button  Padding="8" Click="TestLibraryRoute" ToolTip="{L:Lan 使用所选音效测试当前输出}" AutomationProperties.Name="{L:Lan 测试播放链路}" Width="40"><TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="16"/></Button>
                </StackPanel>
            </Expander>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <WrapPanel Grid.Row="0" Margin="10,0,0,8">
                    <ListBox Style="{StaticResource HorizontalButtonGroupStyle}"
                             x:Name="TopButtonGroupListBox"
                             Margin="0,0,5,0"
                             Height="32.5">
                        <ListBoxItem Style="{StaticResource GroupButtonItemStyle}" Padding="5,0" ToolTip="{L:Lan 全选}">
                            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Ellipse Width="19" Height="19"
                                        Stroke="{DynamicResource AccentColor}"
                                        Fill="Transparent"
                                        StrokeThickness="1.5"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"/>
                                <Ellipse Width="8" Height="8"
                                        Fill="{DynamicResource AccentColor}"
                                        x:Name="SelectCenterPoint"
                                        Visibility="Collapsed"/>
                            </Grid>
                        </ListBoxItem>
                        <ListBoxItem Style="{StaticResource GroupButtonItemStyle}" Padding="3.5" ToolTip="{L:Lan 复制}" AutomationProperties.Name="{L:Lan 复制}">
                            <StackPanel Orientation="Horizontal"><Image Source="{StaticResource CopyIcon}" Width="16" Height="16"/><TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextPrimary}"/></StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Style="{StaticResource GroupButtonItemStyle}" Padding="3.5" ToolTip="{L:Lan 粘贴}" AutomationProperties.Name="{L:Lan 粘贴}">
                            <StackPanel Orientation="Horizontal"><Image Source="{StaticResource PasteIcon}" Width="16" Height="16"/><TextBlock Text="&#xE77F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextPrimary}"/></StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Style="{StaticResource GroupButtonItemStyle}" Padding="6.5" ToolTip="{L:Lan 导入}" AutomationProperties.Name="{L:Lan 导入}">
                            <StackPanel Orientation="Horizontal"><Image Source="{StaticResource ImportIcon}" Width="16" Height="16"/><TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextPrimary}"/></StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Style="{StaticResource GroupButtonItemStyle}" Padding="6.5" ToolTip="{L:Lan 上传}">
                            <Image Source="{StaticResource UploadIcon}"  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ListBoxItem>
                        <ListBoxItem Style="{StaticResource GroupButtonItemStyle}" Padding="6.5,4.5" ToolTip="{L:Lan 删除}" AutomationProperties.Name="{L:Lan 删除}">
                            <StackPanel Orientation="Horizontal"><Image Source="{StaticResource TrashCanIcon}" Width="16" Height="16"/><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextPrimary}"/></StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Style="{StaticResource GroupButtonItemStyle}" Padding="6.5" ToolTip="{L:Lan 文件资源浏览器}">
                            <Image Source="{StaticResource FolderIcon}"  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ListBoxItem>
                    </ListBox>
            <ListBox x:Name="PlaybackModeListBox" HorizontalAlignment="Left"
                     Margin="5,0,0,0" Height="32.5" Style="{StaticResource HorizontalButtonGroupStyle}"
                     SelectionChanged="PlaybackMode_SelectionChanged">
                <ListBoxItem Style="{StaticResource PlaybackModeItemStyle}" ToolTip="{L:Lan 单曲播放}" Padding="12,0">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" Foreground="{DynamicResource AccentColor}"/>
                </ListBoxItem>
                <ListBoxItem Style="{StaticResource PlaybackModeItemStyle}" ToolTip="{L:Lan 单曲循环}" Padding="12,0">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8ED;" Foreground="{DynamicResource AccentColor}"/>
                </ListBoxItem>
                <ListBoxItem Style="{StaticResource PlaybackModeItemStyle}" ToolTip="{L:Lan 列表循环}" Padding="12,0">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8EE;" Foreground="{DynamicResource AccentColor}"/>
                </ListBoxItem>
                <ListBoxItem Style="{StaticResource PlaybackModeItemStyle}" ToolTip="{L:Lan 随机循环}" Padding="12,0">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B1;" Foreground="{DynamicResource AccentColor}"/>
                </ListBoxItem>
            </ListBox>
            </WrapPanel>
            <Border Grid.Row="1" Padding="10,5" Background="Transparent">
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="0"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1"
                               Text="{L:Lan 名称}"
                               Style="{StaticResource TextBlockMedium}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Background="Transparent"
                               Margin="56,0,0,0"/>
                    <TextBlock Grid.Column="2"
                               Text="{L:Lan 时长}"
                               Style="{StaticResource TextBlockMedium}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3"
                               Visibility="Collapsed" Text="{L:Lan 大小}"
                               Style="{StaticResource TextBlockMedium}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4"
                               Text="{L:Lan 快捷键}"
                               Style="{StaticResource TextBlockMedium}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <ListBox Grid.Row="2"
                     x:Name="AudioListBox"
                     ItemsSource="{Binding AudioView}"
                     SelectedItem="{Binding Library.Selected, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     ClipToBounds="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingStackPanel.IsVirtualizing="False"
                     AllowDrop="True"
                     DragOver="ListBox_DragOver"
                     DragLeave="ListBox_DragLeave"
                     Drop="ListBox_Drop">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <local:AudioTrackItem />
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="ClipToBounds" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter ClipToBounds="False"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <TextBlock Grid.Row="2" x:Name="EmptyLibrary" Text="{L:Lan 没有匹配的音效}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource TextPrimary}"/>
            <Border Grid.Row="2" x:Name="FileDropHint" Visibility="Collapsed" IsHitTestVisible="False"
                    BorderBrush="{DynamicResource AccentColor}" BorderThickness="2" CornerRadius="6"
                    Background="{DynamicResource AccentSurfaceSubtle}">
                <TextBlock Text="{L:Lan 拖放音频以导入}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentColor}"/>
            </Border>
            <Canvas Grid.Row="2" x:Name="DragOverlayCanvas" IsHitTestVisible="False">
                <Rectangle x:Name="DragGhost" Opacity="0.45" Visibility="Collapsed">
                    <Rectangle.Effect>
                        <BlurEffect Radius="3"/>
                    </Rectangle.Effect>
                </Rectangle>

                <Border x:Name="InsertionLine" Height="3" Background="{DynamicResource AccentColor}" CornerRadius="1.5" Visibility="Collapsed"/>
            </Canvas>

        </Grid>
        </DockPanel>
    </Border>
</Page>
