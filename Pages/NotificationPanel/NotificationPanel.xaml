<UserControl x:Class="PlayVoice.Pages.NotificationPanel.NotificationPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:L="clr-namespace:PlayVoice.Resources.Language">
 <ItemsControl x:Name="Panel" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12" ItemsSource="{Binding NotificationItems, RelativeSource={RelativeSource AncestorType=UserControl}}">
  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
  <ItemsControl.ItemTemplate><DataTemplate><Grid>
   <Border x:Name="NotifyBorder" Width="340" Margin="0,0,0,8" Background="{DynamicResource BgMedium}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="16" MouseEnter="NotifyBorder_MouseEnter" MouseLeave="NotifyBorder_MouseLeave">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
     <Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" Style="{StaticResource ChromeButton}" Width="28" Height="28" MinHeight="28" Padding="0" Click="NotificationClose_Click" Tag="{Binding}" ToolTip="{L:Lan 关闭}" AutomationProperties.Name="{L:Lan 关闭}"/>
     <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Message}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" FontSize="{DynamicResource UiFontSize12}" LineHeight="19" Margin="0,6,0,0"/>
    </Grid>
   </Border>
   <Border Width="0" Height="0" Opacity="0" IsHitTestVisible="False" Loaded="DismissTimer_Loaded"/>
  </Grid></DataTemplate></ItemsControl.ItemTemplate>
 </ItemsControl>
</UserControl>