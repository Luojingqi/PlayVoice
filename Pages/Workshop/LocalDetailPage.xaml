<UserControl x:Class="PlayVoice.Pages.Workshop.LocalDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PlayVoice.Pages.Workshop"
      xmlns:L="clr-namespace:PlayVoice.Resources.Language"
      mc:Ignorable="d"
      x:Name="self">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Style/ListBox.xaml"/>
                <ResourceDictionary Source="/Resources/Style/Copy.xaml"/>
                <ResourceDictionary Source="/Resources/Style/Folder.xaml"/>
                <ResourceDictionary Source="/Resources/Style/WorkshopFeedback.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Rectangle Grid.Column="0"
                    Stroke="{DynamicResource AccentColor}" 
                    StrokeThickness="2" 
                    StrokeDashArray="4 2" 
                    Fill="Transparent" 
                    RadiusX="5" 
                    RadiusY="5"
                    Width="160"
                    Height="160" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"/>
            <Border Grid.Column="0" CornerRadius="5" ClipToBounds="True" Height="146" Width="146" Background="{DynamicResource BgLight}">
                <Image  x:Name="BgImage"  
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Top"/>
            </Border>

            <Border Grid.Column="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Margin="0,5" Grid.Row="0">
                        <TextBlock Style="{StaticResource TextBlockMedium}"
                                        x:Name="ItemTitle" 
                                        HorizontalAlignment="Center" 
                                        VerticalAlignment="Top"
                                        FontSize="15"/>
                    </Border>
                    <StackPanel Grid.Row="1"
                                x:Name="AuthorPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Height="29"
                                Margin="0,2,0,5"
                                Visibility="Hidden">
                        <Border Width="24" Height="24" CornerRadius="12" ClipToBounds="True"
                                Background="{DynamicResource BgLight}" Margin="0,0,7,0">
                            <Image x:Name="AuthorAvatar" Stretch="UniformToFill"/>
                        </Border>
                        <TextBlock x:Name="AuthorName"
                                   Style="{StaticResource TextBlockMedium}"
                                   Foreground="{DynamicResource AccentColor}"
                                   VerticalAlignment="Center"
                                   Cursor="Hand"
                                   TextDecorations="Underline"
                                   MouseLeftButtonUp="AuthorName_MouseLeftButtonUp"/>
                    </StackPanel>
                </Grid>
            </Border>


            <StackPanel Grid.Column="2" HorizontalAlignment="Center" Margin="5,0">
                <TextBlock x:Name="SteamScoreText"
                           Text="★ --"
                           Style="{StaticResource TextBlockMedium}"
                           Foreground="{DynamicResource Warning}"
                           HorizontalAlignment="Center"
                           Margin="0,11,0,5"/>
                <Button Style="{StaticResource WorkshopStandaloneButtonStyle}"
                        ToolTip="{L:Lan Steam详情}"
                        Click="OpenWorkshopPage_Click">
                    <Viewbox Width="16" Height="16">
                        <Path Data="{StaticResource WorkshopOpenIcon}" Stroke="{DynamicResource AccentColor}" StrokeThickness="1.7"/>
                    </Viewbox>
                </Button>
                <Button Style="{StaticResource WorkshopStandaloneButtonStyle}"
                        ToolTip="{L:Lan 复制链接}"
                        Click="CopyWorkshopUrl_Click">
                    <Viewbox Width="16" Height="16">
                        <Path Data="{StaticResource WorkshopCopyLinkIcon}" Stroke="{DynamicResource AccentColor}" StrokeThickness="1.7"/>
                    </Viewbox>
                </Button>
                <Button Style="{StaticResource WorkshopStandaloneButtonStyle}"
                        ToolTip="{L:Lan 举报}"
                        Click="ReportWorkshopItem_Click">
                    <Viewbox Width="16" Height="16">
                        <Path Data="{StaticResource WorkshopReportIcon}" Stroke="{DynamicResource Error}" StrokeThickness="1.7"/>
                    </Viewbox>
                </Button>
            </StackPanel>

            <Grid Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ListBox Margin="0.25,1.5,0.25,1" Grid.Row="0" 
                    Style="{StaticResource HorizontalButtonGroupStyle}"
                    x:Name="FoldUpButton" HorizontalAlignment="Center" Width="46" Tag="Uniform">
                    <ListBoxItem Style="{StaticResource GroupButtonItemStyle}">
                        <TextBlock Style="{StaticResource TextBlockHeavy}"
                                Text=">>>" Foreground="{DynamicResource AccentColor}"/>
                    </ListBoxItem>
                </ListBox>

                <ListBox Margin="0.25,2.5" Grid.Row="1" 
                    Style="{StaticResource HorizontalButtonGroupStyle}"
                    x:Name="SubscribeButton" HorizontalAlignment="Center" Width="46" Tag="Uniform">
                    <ListBoxItem Style="{StaticResource GroupButtonItemStyle}">
                        <TextBlock Style="{StaticResource TextBlockHeavy}"
                                Text="{L:Lan 订阅按钮}" Foreground="{DynamicResource AccentColor}"/>
                    </ListBoxItem>
                </ListBox>
                <ListBox Margin="0.25,2.5" Grid.Row="1" 
                    Style="{StaticResource HorizontalButtonGroupStyle}"
                    x:Name="UnSubscribeButton" HorizontalAlignment="Center" Width="46" Tag="Uniform">
                    <ListBoxItem Style="{StaticResource GroupButtonItemStyle}">
                        <TextBlock Style="{StaticResource TextBlockHeavy}"
                            Text="{L:Lan 取消订阅按钮}" Foreground="{DynamicResource AccentColor}"/>
                    </ListBoxItem>
                </ListBox>

                <ListBox Margin="0.25,2.5" Grid.Row="2"
                         Style="{StaticResource VerticalButtonGroupStyle}"
                         x:Name="FeedbackButton" HorizontalAlignment="Center" Width="46">
                    <ListBoxItem x:Name="UpvoteButton" Style="{StaticResource VerticalGroupButtonItemStyle}" Padding="7,5"
                                 ToolTip="{L:Lan 好评}">
                        <Viewbox Width="16" Height="16">
                            <Path x:Name="UpvoteIcon" Fill="{DynamicResource AccentColor}"
                                  Data="{StaticResource WorkshopUpvoteIcon}"/>
                        </Viewbox>
                    </ListBoxItem>
                    <ListBoxItem x:Name="DownvoteButton" Style="{StaticResource VerticalGroupButtonItemStyle}" Padding="7,5"
                                 ToolTip="{L:Lan 差评}">
                        <Viewbox Width="16" Height="16">
                            <Path x:Name="DownvoteIcon" Fill="{DynamicResource AccentColor}"
                                  Data="{StaticResource WorkshopDownvoteIcon}"/>
                        </Viewbox>
                    </ListBoxItem>
                    <ListBoxItem x:Name="FavoriteButton" Style="{StaticResource VerticalGroupButtonItemStyle}" Padding="7,5"
                                 ToolTip="{L:Lan 喜欢}">
                        <Viewbox Width="16" Height="16">
                            <Path x:Name="FavoriteIcon" Fill="{DynamicResource AccentColor}"
                                  Data="{StaticResource WorkshopFavoriteIcon}"/>
                        </Viewbox>
                    </ListBoxItem>
                </ListBox>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,8,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <ListBox Grid.Column="0"
                        Style="{StaticResource HorizontalButtonGroupStyle}"
                        x:Name="CheckBoxListBox">
                    <ListBoxItem Style="{StaticResource GroupButtonItemStyle}" Padding="5,0">
                        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Ellipse Width="19" Height="19"
                                    Stroke="{DynamicResource AccentColor}"
                                    Fill="Transparent"
                                    StrokeThickness="1.5"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"/>
                            <Ellipse Width="8" Height="8"
                                    Fill="{DynamicResource AccentColor}"
                                    x:Name="SelectCenterPoint"
                                     Visibility="Collapsed"/>
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource GroupButtonItemStyle}" Padding="3.5" ToolTip="{L:Lan 复制}">
                        <Image Source="{StaticResource CopyIcon}"  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource GroupButtonItemStyle}" Padding="6.5" ToolTip="{L:Lan 文件资源浏览器}">
                        <Image Source="{StaticResource FolderIcon}"  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ListBoxItem>
                </ListBox>

                <TextBlock Grid.Column="1" 
                           Text="{L:Lan 名称}"  
                           Style="{StaticResource TextBlockMedium}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Padding="0,0,30,0"/>
                <TextBlock Grid.Column="2" 
                           Text="{L:Lan 时长}"
                           Style="{StaticResource TextBlockMedium}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="5,0"/>
                <TextBlock Grid.Column="3" 
                           Text="{L:Lan 大小}" 
                           Style="{StaticResource TextBlockMedium}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="5,0"/>
            </Grid>

            <ListBox Grid.Row="1" 
                     x:Name="AudioListBox"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <local:LocalDetailPageItem/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
