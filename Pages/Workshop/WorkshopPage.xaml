<Page x:Class="PlayVoice.Pages.Workshop.WorkshopPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:L="clr-namespace:PlayVoice.Resources.Language"
      xmlns:TransparentAndBottomLineListBox="clr-namespace:PlayVoice.Pages.TransparentAndBottomLineListBox"
      xmlns:local="clr-namespace:PlayVoice.Pages.Workshop"
      xmlns:DropDownList="clr-namespace:PlayVoice.Pages.DropDownList"
      mc:Ignorable="d" >

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Style/Button.xaml"/>
                <ResourceDictionary Source="/Resources/Style/PageBox.xaml"/>
                <ResourceDictionary Source="/Resources/Style/ListBox.xaml"/>
                <ResourceDictionary Source="/Resources/Style/ComboBox.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <TextBlock Grid.Row="0" Text="{L:Lan 创意工坊}" FontSize="{DynamicResource UiFontSize28}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
        <Border Grid.Row="1" Margin="0,0,0,8">
            <ListBox Style="{StaticResource StudioNavTabs}"
                     TransparentAndBottomLineListBox:ListBoxHelper.LinePosition="Top"
                     x:Name="TopButtonListBox"/>
        </Border>

        <Grid Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Center"
              Margin="0,0,0,16"
              x:Name="UpperRightInputField">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" BorderBrush="{DynamicResource Border}"
                    Style="{StaticResource HorizontalButtonGroupStyle}"
                    Background="{DynamicResource BgMedium}"
                    x:Name="ItemGroupListBox">
                <ListBoxItem Style="{StaticResource GroupInputItemStyle}"
                             Width="125">
                    <TextBox x:Name="SearchTextBox"
                        Tag="{L:Lan 关键词}"
                        Style="{StaticResource GroupTextBoxStyle}"
                        KeyDown="SearchTextBox_KeyDown"/>
                </ListBoxItem>
                <ListBoxItem Style="{StaticResource GroupButtonItemStyle}"
                             Width="50">
                    <TextBlock Text="{L:Lan 搜索}"
                        Style="{StaticResource TextBlockLight}"/>
                </ListBoxItem>
            </ListBox>

            <TextBlock Grid.Column="1" 
                       Text="{L:Lan 排序}"
                       Style="{StaticResource TextBlockLight}"
                       FontSize="{DynamicResource UiFontSize16}"
                       Margin="15,0,0,0"
                       TextAlignment="Center" 
                       VerticalAlignment="Center"/>
            <ComboBox Grid.Column="2"
                x:Name="RankedComboBox"
                Style="{StaticResource TransparentComboBoxStyle}"
                Background="{DynamicResource BgMedium}"
                Width="130"
                MinHeight="38"
                FontSize="{DynamicResource UiFontSize15}"
                Margin="10,0,0,0"
                BorderBrush="{DynamicResource Border}" />
        </Grid>

        <Border Grid.Row="3" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <local:TablePage x:Name="TablePage" Grid.Column="0"/>
                <local:WorkshopHorizontalView x:Name="WorkshopHorizontalView"
                                              Grid.Column="0"
                                              Visibility="Collapsed"/>
                <Border Grid.Column="1"
                        x:Name="DetailPageBorder"
                        Width="0" 
                        ClipToBounds="True"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Margin="0"
                        Padding="5"
                        Background="{DynamicResource BgMedium}">
                    <Grid>
                        <Frame x:Name="DetailPageFrame"/>
                    </Grid>
                </Border>
                <Border Grid.Column="1"
                        x:Name="LocalDetailPageBorder"
                        Width="0" 
                        ClipToBounds="True"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Margin="0"
                        Padding="5"
                        Background="{DynamicResource BgMedium}">
                    <Grid>
                        <Frame x:Name="LocalDetailPageFrame"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <Frame Grid.Row="3" x:Name="LoadingPageFrame"/>

        <Border Grid.Row="4" Margin="0,12.5,0,0">
            <ListBox Style="{StaticResource StudioNavTabs}"
                     TransparentAndBottomLineListBox:ListBoxHelper.LinePosition="Bottom"
                     x:Name="BottomButtonListBox"
                     SelectionMode="Multiple">
            </ListBox>
        </Border>

        <Grid Grid.Row="4"
              Margin="0,6.5,11,5"
              HorizontalAlignment="Right"
              VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0"
                  x:Name="SearchLanguageInputField"
                  Margin="0,0,15,0"
                  Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{L:Lan 搜索语言}"
                           Style="{StaticResource TextBlockLight}"
                           FontSize="{DynamicResource UiFontSize16}"
                           TextAlignment="Center"
                           VerticalAlignment="Center"/>
                <Grid Grid.Column="1"
                      Width="150"
                      MinHeight="38"
                      Margin="10,0,0,0">
                    <ToggleButton x:Name="SearchLanguageDropDownButton"
                                  Background="{DynamicResource BgMedium}"
                                  BorderBrush="{DynamicResource Border}"
                                  BorderThickness="1"
                                  ClickMode="Press"
                                  Focusable="False">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="MainBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8">
                                    <TextBlock Text="{TemplateBinding Content}"
                                               Margin="4,1,7,1"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontFamily="{DynamicResource FontLight}"
                                               FontSize="{DynamicResource UiFontSize15}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="MainBorder"
                                                Property="BorderBrush"
                                                Value="{DynamicResource AccentColorSecondary}"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="MainBorder"
                                                Property="BorderBrush"
                                                Value="{DynamicResource AccentColorSecondary}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <Popup IsOpen="{Binding IsChecked, ElementName=SearchLanguageDropDownButton, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=SearchLanguageDropDownButton}"
                           Placement="Top"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Slide"
                           Closed="SearchLanguagePopup_Closed">
                        <Border Background="{DynamicResource BgMedium}"
                                BorderBrush="{DynamicResource Border}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,0,2"
                                Width="150">
                            <ListBox x:Name="SearchLanguageListBox"
                                     SelectionMode="Multiple"
                                     MaxHeight="300"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     SelectionChanged="SearchLanguageListBox_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                        <Setter Property="FontFamily" Value="{DynamicResource FontLight}"/>
                                        <Setter Property="Height" Value="30"/>
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBorder"
                                                            Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="18"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0"
                                                                    Width="13"
                                                                    Height="13"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center"
                                                                    BorderBrush="{DynamicResource Border}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="2">
                                                                <TextBlock x:Name="CheckMark"
                                                                           Text="✓"
                                                                           FontSize="{DynamicResource UiFontSize11}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource AccentColor}"
                                                                           Visibility="Collapsed"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Name}"
                                                                       Foreground="{TemplateBinding Foreground}"
                                                                       FontFamily="{TemplateBinding FontFamily}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder"
                                                                    Property="Background"
                                                                    Value="{DynamicResource AccentSurface}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder"
                                                                    Property="Background"
                                                                    Value="{DynamicResource BgDark}"/>
                                                            <Setter TargetName="CheckMark"
                                                                    Property="Visibility"
                                                                    Value="Visible"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>

            <Frame Grid.Column="1"
                   x:Name="PageNumberSelectionFrame"/>
        </Grid>
        <Border x:Name="WorkshopEditorHost" Grid.RowSpan="3" Panel.ZIndex="10"
                Background="{DynamicResource BgMedium}" Visibility="Collapsed">
            <Frame x:Name="WorkshopEditorFrame" NavigationUIVisibility="Hidden"/>
        </Border>
    </Grid>
</Page>
