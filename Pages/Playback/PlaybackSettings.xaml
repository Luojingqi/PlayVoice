<UserControl x:Class="PlayVoice.Pages.Playback.PlaybackSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:L="clr-namespace:PlayVoice.Resources.Language"
    xmlns:local="clr-namespace:PlayVoice.Pages.Playback"
    xmlns:ExpandArrow="clr-namespace:PlayVoice.Pages.ExpandArrow"
    xmlns:HeaderToolTip="clr-namespace:PlayVoice.Pages.HeaderToolTip">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Resources/Style/ListBox.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <StackPanel>
        <Grid Height="42.5" Margin="0,1.5">
            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ExpandArrow:ExpandArrow x:Name="ControlsExpandArrow" HorizontalAlignment="Center" VerticalAlignment="Center" ExpandedChanged="Controls_ExpandedChanged"/>
            <HeaderToolTip:HeaderToolTip Grid.Column="1" Header="{L:Lan 播放控制}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <local:PlaybackTransport Grid.Column="2" Width="130" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </Grid>
        <StackPanel x:Name="ControlHotkeyPanel" Height="0" Opacity="0" ClipToBounds="True" IsHitTestVisible="False">
            <StackPanel.RenderTransform><TranslateTransform Y="-6"/></StackPanel.RenderTransform>
            <Grid Height="37.5" Margin="0,1.5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <HeaderToolTip:HeaderToolTip Grid.Column="1" Header="{L:Lan 上一首}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <ListBox Grid.Column="2" Width="96" Margin="10,0,0,0" Tag="Uniform" Style="{StaticResource HorizontalButtonGroupStyle}">
                    <ListBoxItem Style="{StaticResource GroupInputItemStyle}">
                        <TextBox x:Name="PreviousInput" Tag="{L:Lan 输入按键}" Style="{StaticResource GroupTextBoxStyle}"
                                 GotFocus="Hotkey_GotFocus" LostFocus="Hotkey_LostFocus" InputMethod.IsInputMethodEnabled="False"/>
                    </ListBoxItem>
                </ListBox>
            </Grid>
            <Grid Height="37.5" Margin="0,1.5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <HeaderToolTip:HeaderToolTip Grid.Column="1" Header="{L:Lan 暂停或继续}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <ListBox Grid.Column="2" Width="96" Margin="10,0,0,0" Tag="Uniform" Style="{StaticResource HorizontalButtonGroupStyle}">
                    <ListBoxItem Style="{StaticResource GroupInputItemStyle}">
                        <TextBox x:Name="PauseInput" Tag="{L:Lan 输入按键}" Style="{StaticResource GroupTextBoxStyle}"
                                 GotFocus="Hotkey_GotFocus" LostFocus="Hotkey_LostFocus" InputMethod.IsInputMethodEnabled="False"/>
                    </ListBoxItem>
                </ListBox>
            </Grid>
            <Grid Height="37.5" Margin="0,1.5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <HeaderToolTip:HeaderToolTip Grid.Column="1" Header="{L:Lan 下一首}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <ListBox Grid.Column="2" Width="96" Margin="10,0,0,0" Tag="Uniform" Style="{StaticResource HorizontalButtonGroupStyle}">
                    <ListBoxItem Style="{StaticResource GroupInputItemStyle}">
                        <TextBox x:Name="NextInput" Tag="{L:Lan 输入按键}" Style="{StaticResource GroupTextBoxStyle}"
                                 GotFocus="Hotkey_GotFocus" LostFocus="Hotkey_LostFocus" InputMethod.IsInputMethodEnabled="False"/>
                    </ListBoxItem>
                </ListBox>
            </Grid>
            <Grid Height="37.5" Margin="0,1.5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <HeaderToolTip:HeaderToolTip Grid.Column="1" Header="{L:Lan 停止全部}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <ListBox Grid.Column="2" Width="96" Margin="10,0,0,0" Tag="Uniform" Style="{StaticResource HorizontalButtonGroupStyle}">
                    <ListBoxItem Style="{StaticResource GroupInputItemStyle}">
                        <TextBox x:Name="StopInput" Tag="{L:Lan 输入按键}" Style="{StaticResource GroupTextBoxStyle}"
                                 GotFocus="Hotkey_GotFocus" LostFocus="Hotkey_LostFocus" InputMethod.IsInputMethodEnabled="False"/>
                    </ListBoxItem>
                </ListBox>
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>
