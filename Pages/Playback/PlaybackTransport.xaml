<UserControl x:Class="PlayVoice.Pages.Playback.PlaybackTransport" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:L="clr-namespace:PlayVoice.Resources.Language">
 <StackPanel x:Name="Buttons" Orientation="Horizontal" VerticalAlignment="Center">
  <Button Tag="Previous" Click="Control_Click" Style="{StaticResource TransportButton}" ToolTip="{L:Lan 上一首}" AutomationProperties.Name="{L:Lan 上一首}"><Path Data="M 4,3 L 4,17 M 16,3 L 6,10 L 16,17 Z" Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.5" StrokeLineJoin="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
  <Button Tag="Play" Click="Control_Click" Style="{StaticResource TransportPlayButton}" Margin="5,0" ToolTip="{L:Lan 暂停或继续}" AutomationProperties.Name="{L:Lan 暂停或继续}"><Path x:Name="PauseIcon" Data="M 6,3 L 17,10 L 6,17 Z" Width="16" Height="16" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
  <Button Tag="Next" Click="Control_Click" Style="{StaticResource TransportButton}" ToolTip="{L:Lan 下一首}" AutomationProperties.Name="{L:Lan 下一首}"><Path Data="M 16,3 L 16,17 M 4,3 L 14,10 L 4,17 Z" Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.5" StrokeLineJoin="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
 </StackPanel>
</UserControl>