<UserControl x:Class="PlayVoice.Pages.ToggleSwitchButton.ToggleSwitchButton"
             x:Name="self"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PlayVoice.Pages.ToggleSwitchButton"
             xmlns:pages="clr-namespace:PlayVoice.Pages"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Style/ComboBox.xaml"/>
                <ResourceDictionary Source="/Resources/Style/Button.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Padding="{Binding Padding, ElementName=self}">
        <Grid Margin="{Binding Margin, ElementName=self}">
            <!--Opacity淡化颜色-->
            <Border CornerRadius="3.5" Opacity="0.125">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LabelStatus, ElementName=self}" Value="Error">
                                <Setter Property="Background" Value="{DynamicResource Error}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding LabelStatus, ElementName=self}" Value="Warning">
                                <Setter Property="Background" Value="{DynamicResource Warning}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding LabelStatus, ElementName=self}" Value="Success">
                                <Setter Property="Background" Value="{DynamicResource Success}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Margin="13.5,0,0,0"
                            ToolTipService.InitialShowDelay="180"
                            ToolTip="{Binding ToolTipText, ElementName=self}">
                    <StackPanel.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HelpIconScale"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     To="1.18"
                                                     Duration="0:0:0.18"/>
                                    <DoubleAnimation Storyboard.TargetName="HelpIconScale"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     To="1.18"
                                                     Duration="0:0:0.18"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HelpIconScale"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     To="1"
                                                     Duration="0:0:0.12"/>
                                    <DoubleAnimation Storyboard.TargetName="HelpIconScale"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     To="1"
                                                     Duration="0:0:0.12"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </StackPanel.Triggers>
                    <TextBlock Text="{Binding Header, ElementName=self}"
                               Style="{StaticResource TextBlockLight}"
                               VerticalAlignment="Center"
                               FontSize="{Binding TextBlockFontSize, ElementName=self}"
                               TextAlignment="Left"/>
                    <Border Width="13"
                            Height="13"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            BorderBrush="{DynamicResource TextSecondary}"
                            BorderThickness="1"
                            CornerRadius="6.5"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="HelpIconScale"/>
                        </Border.RenderTransform>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ToolTipText, ElementName=self}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ToolTipText, ElementName=self}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="?"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontFamily="{DynamicResource FontMedium}"
                                   FontSize="9"
                                   LineHeight="11"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <ToggleButton x:Name="toggleButton"
                    Style="{StaticResource ToggleSwitchStyle}"
                    Grid.Column="1"
                    Width="{Binding ButtonWidth, ElementName=self}"
                    IsChecked="{Binding IsChecked, ElementName=self, Mode=TwoWay}"
                    HorizontalAlignment="Right"
                    Margin="0,3.5,20,3.5"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
