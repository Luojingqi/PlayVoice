<Page x:Class="PlayVoice.Pages.Setting.TutorialPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PlayVoice.Pages.Setting"
      xmlns:L="clr-namespace:PlayVoice.Resources.Language"
      xmlns:Hyperlink="clr-namespace:PlayVoice.Pages.Hyperlink"
      mc:Ignorable="d" >

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Style/PageBox.xaml"/>
                <ResourceDictionary Source="/Resources/Style/TrashCan.xaml"/>
                <ResourceDictionary Source="/Resources/Style/Import.xaml"/>
                <ResourceDictionary Source="/Resources/Style/Upload.xaml"/>
                <ResourceDictionary Source="/Resources/Style/Copy.xaml"/>
                <ResourceDictionary Source="/Resources/Style/Paste.xaml"/>
                <ResourceDictionary Source="/Resources/Style/Folder.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <HeaderedContentControl Style="{StaticResource PageBoxStyle}"
                        Header="{L:Lan 教程}">
        <StackPanel Margin="4,2.5,3,0">
            <StackPanel>
                <Button Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        HorizontalAlignment="Left"
                        Padding="0"
                        Margin="0,5,0,0"
                        Hyperlink:HyperlinkBehavior.Url="https://source-xu.top/projects/playvoice">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{L:Lan 点击观看视频演示}"
                                   Style="{StaticResource TextBlockMedium}"
                                   FontSize="15"/>
                        <Path Width="14"
                              Height="14"
                              Margin="6,0,0,0"
                              VerticalAlignment="Center"
                              Stretch="Uniform"
                              Stroke="{DynamicResource AccentColor}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Data="M2,3 L2,12 L11,12 L11,9 M7,2 L12,2 L12,7 M12,2 L6,8"/>
                    </StackPanel>
                </Button>
                <Border Height="1"
                        Background="{DynamicResource Border}"
                        Margin="20,8,20,3"/>
            </StackPanel>

            <local:TutorialSection Header="{L:Lan 教程1_标题}">
                <local:TutorialSection.SectionContent>
                    <TextBlock TextWrapping="Wrap"
                               Style="{StaticResource TextBlockLight}"
                               Margin="10,5"
                               FontSize="13.5">
                        <Run Text="{L:Lan 教程1_内容}"/>
                        <LineBreak/>
                        <LineBreak/>
                        <Run Text="{L:Lan 教程3_内容}"/>
                    </TextBlock>
                </local:TutorialSection.SectionContent>
            </local:TutorialSection>

            <Border Height="1"
                    Background="{DynamicResource Border}"
                    Margin="20,3"/>
            <local:TutorialSection Header="{L:Lan 教程4_标题}">
                <local:TutorialSection.SectionContent>
                    <TextBlock Text="{L:Lan 教程4_内容}"
                               TextWrapping="Wrap"
                               Style="{StaticResource TextBlockLight}"
                               Margin="10,5"
                               FontSize="13.5"/>
                </local:TutorialSection.SectionContent>
            </local:TutorialSection>

            <Border Height="1"
                    Background="{DynamicResource Border}"
                    Margin="20,3"/>

            <local:TutorialSection Header="{L:Lan 教程2_标题}">
                <local:TutorialSection.SectionContent>
                    <WrapPanel Margin="0,5,0,0"
                               HorizontalAlignment="Center"
                               ItemWidth="105">
                <Grid VerticalAlignment="Top" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32.5"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Ellipse Grid.Row="0"
                            Margin="5,0"
                            Width="19" Height="19"
                            Stroke="{DynamicResource AccentColor}"
                            Fill="Transparent"
                            StrokeThickness="1.5"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"/>
                    <TextBlock Grid.Row="1" 
                            Text="{L:Lan 教程2_内容_选择}"
                            TextWrapping="WrapWithOverflow"
                            TextAlignment="Center"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource TextBlockLight}"
                            Margin="4,5"
                            FontSize="13.5"/>
                </Grid>
                <Grid VerticalAlignment="Top" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32.5"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Image Grid.Row="0" Margin="3.5"
                        Source="{StaticResource CopyIcon}"  
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" 
                        Text="{L:Lan 教程2_内容_复制}"
                        TextWrapping="WrapWithOverflow"
                        TextAlignment="Center"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource TextBlockLight}"
                        Margin="4,5"
                        FontSize="13.5"/>
                </Grid>
                <Grid VerticalAlignment="Top" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32.5"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Image Grid.Row="0" Margin="3.5"
                        Source="{StaticResource PasteIcon}"  
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" 
                                Text="{L:Lan 教程2_内容_粘贴}"
                                TextWrapping="WrapWithOverflow"
                                TextAlignment="Center"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource TextBlockLight}"
                                Margin="4,5"
                                FontSize="13.5"/>
                </Grid>
                <Grid VerticalAlignment="Top" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32.5"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Image Grid.Row="0" Margin="3.5"
                            Source="{StaticResource ImportIcon}"  
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" 
                            Text="{L:Lan 教程2_内容_导入}"
                            TextWrapping="WrapWithOverflow"
                            TextAlignment="Center"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource TextBlockLight}"
                            Margin="4,5"
                            FontSize="13.5"/>
                </Grid>
                <Grid VerticalAlignment="Top" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32.5"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Image Grid.Row="0" Margin="3.5"
                            Source="{StaticResource UploadIcon}"  
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" 
                            Text="{L:Lan 教程2_内容_上传}"
                            TextWrapping="WrapWithOverflow"
                            TextAlignment="Center"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource TextBlockLight}"
                            Margin="4,5"
                            FontSize="13.5"/>
                </Grid>
                <Grid VerticalAlignment="Top" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32.5"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Image Grid.Row="0" Margin="3.5"
                            Source="{StaticResource TrashCanIcon}"  
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" 
                            Text="{L:Lan 教程2_内容_删除}"
                            TextWrapping="WrapWithOverflow"
                            TextAlignment="Center"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource TextBlockLight}"
                            Margin="4,5"
                            FontSize="13.5"/>
                </Grid>
                <Grid VerticalAlignment="Top" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32.5"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Image Grid.Row="0" Margin="3.5"
                            Source="{StaticResource FolderIcon}"  
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" 
                            Text="{L:Lan 教程2_内容_文件}"
                            TextWrapping="WrapWithOverflow"
                            TextAlignment="Center"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource TextBlockLight}"
                            Margin="4,5"
                            FontSize="13.5"/>
                </Grid>
                    </WrapPanel>
                </local:TutorialSection.SectionContent>
            </local:TutorialSection>

            <Border Height="1"
                    Background="{DynamicResource Border}"
                    Margin="20,3"/>

            <local:TutorialSection Header="{L:Lan 教程8_标题}">
                <local:TutorialSection.SectionContent>
                    <TextBlock Text="{L:Lan 教程8_内容}"
                               TextWrapping="Wrap"
                               Style="{StaticResource TextBlockLight}"
                               Margin="10,5"
                               FontSize="13.5"/>
                </local:TutorialSection.SectionContent>
            </local:TutorialSection>

            <Border Height="1"
                    Background="{DynamicResource Border}"
                    Margin="20,3"/>

            <local:TutorialSection Header="{L:Lan 教程5_标题}">
                <local:TutorialSection.SectionContent>
                    <TextBlock Text="{L:Lan 教程5_内容}"
                               TextWrapping="Wrap"
                               Style="{StaticResource TextBlockLight}"
                               Margin="10,5"
                               FontSize="13.5"/>
                </local:TutorialSection.SectionContent>
            </local:TutorialSection>

            <Border Height="1"
                    Background="{DynamicResource Border}"
                    Margin="20,3"/>

            <local:TutorialSection Header="{L:Lan 教程6_标题}">
                <local:TutorialSection.SectionContent>
                    <TextBlock Text="{L:Lan 教程6_内容}"
                               TextWrapping="Wrap"
                               Style="{StaticResource TextBlockLight}"
                               Margin="10,5"
                               FontSize="13.5"/>
                </local:TutorialSection.SectionContent>
            </local:TutorialSection>

            <Border Height="1"
                    Background="{DynamicResource Border}"
                    Margin="20,3"/>

            <local:TutorialSection Header="{L:Lan 教程7_标题}">
                <local:TutorialSection.SectionContent>
                    <TextBlock Text="{L:Lan 教程7_内容}"
                               TextWrapping="Wrap"
                               Style="{StaticResource TextBlockLight}"
                               Margin="10,5"
                               FontSize="13.5"/>
                </local:TutorialSection.SectionContent>
            </local:TutorialSection>

            <Border Margin="0,1.5,0,0"/>
        </StackPanel>
    </HeaderedContentControl>
</Page>
