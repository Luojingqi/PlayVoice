<Page x:Class="PlayVoice.Pages.Setting.SettingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:L="clr-namespace:PlayVoice.Resources.Language"
      xmlns:Hyperlink="clr-namespace:PlayVoice.Pages.Hyperlink"
      xmlns:Setting="clr-namespace:PlayVoice.Pages.Setting"
      mc:Ignorable="d">

 <DockPanel>
 <StackPanel DockPanel.Dock="Top" Margin="0,0,0,22"><TextBlock Text="{L:Lan 设置}" FontSize="{DynamicResource UiFontSize28}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/></StackPanel>
 <TabControl Style="{StaticResource StudioTabs}">
  <TabItem Header="{L:Lan 声卡绑定}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top"><StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Top"><Frame NavigationUIVisibility="Hidden" Source="/Pages/Setting/SoundCardBindingPage.xaml" Margin="0,0,0,16"/><Frame NavigationUIVisibility="Hidden" Source="/Pages/Setting/VirtualSoundCardInstallationPage.xaml"/></StackPanel></ScrollViewer></TabItem>
  <TabItem Header="{L:Lan 系统}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top"><Frame HorizontalAlignment="Stretch" VerticalAlignment="Top" NavigationUIVisibility="Hidden" Source="/Pages/Setting/SystemSettingsPage.xaml"/></ScrollViewer></TabItem>
  <TabItem Header="{L:Lan 主题配色}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,8,0,24">
 <WrapPanel x:Name="PaletteChoices" Margin="0,0,0,16"/>
 <Border Background="{DynamicResource BgMedium}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="20"><StackPanel>
  <TextBlock Text="{L:Lan 主题}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/><ComboBox x:Name="AppearanceChoices" Width="240" HorizontalAlignment="Left" MinHeight="38" DisplayMemberPath="Name"/>
  <TextBlock Text="{L:Lan 自定义主题}" Foreground="{DynamicResource TextSecondary}" Margin="0,20,0,8"/><ComboBox x:Name="CustomThemeChoices" Width="300" HorizontalAlignment="Left" MinHeight="38"/>
  <TextBlock Text="{L:Lan 主题名称}" Foreground="{DynamicResource TextSecondary}" Margin="0,20,0,8"/><TextBox x:Name="ThemeNameInput" MaxLength="80" Width="300" HorizontalAlignment="Left" AutomationProperties.Name="{L:Lan 主题名称}"/>
  <TextBlock Text="{L:Lan 字体}" Foreground="{DynamicResource TextSecondary}" Margin="0,20,0,8"/><ComboBox x:Name="FontChoices" Width="300" HorizontalAlignment="Left" MinHeight="38"/>
  <TextBlock Text="{L:Lan 界面字号}" Foreground="{DynamicResource TextSecondary}" Margin="0,20,0,8"/><StackPanel Orientation="Horizontal"><Slider x:Name="FontSizeInput" Minimum="11" Maximum="18" TickFrequency="1" IsSnapToTickEnabled="True" Width="240"/><TextBlock Text="{Binding Value, ElementName=FontSizeInput, StringFormat={}{0:0} px}" Foreground="{DynamicResource TextPrimary}" Margin="16,0,0,0"/></StackPanel>
<TextBlock Text="{L:Lan 强调色}" Foreground="{DynamicResource TextSecondary}" Margin="0,20,0,8"/><StackPanel Orientation="Horizontal"><TextBox x:Name="AccentInput" Width="220" MaxLength="7" ToolTip="#RRGGBB" AutomationProperties.Name="{L:Lan 强调色}"/><Button Tag="Accent" Click="ChooseAppearanceColor" Width="40" Margin="8,0,0,0" ToolTip="{L:Lan 强调色}" AutomationProperties.Name="{L:Lan 强调色}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE790;"/></Button></StackPanel><TextBlock Text="{L:Lan 背景色}" Foreground="{DynamicResource TextSecondary}" Margin="0,20,0,8"/><StackPanel Orientation="Horizontal"><TextBox x:Name="BackgroundInput" Width="220" MaxLength="7" ToolTip="#RRGGBB" AutomationProperties.Name="{L:Lan 背景色}"/><Button Tag="Background" Click="ChooseAppearanceColor" Width="40" Margin="8,0,0,0" ToolTip="{L:Lan 背景色}" AutomationProperties.Name="{L:Lan 背景色}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE790;"/></Button></StackPanel><TextBlock Text="{L:Lan 前景色}" Foreground="{DynamicResource TextSecondary}" Margin="0,20,0,8"/><StackPanel Orientation="Horizontal"><TextBox x:Name="ForegroundInput" Width="220" MaxLength="7" ToolTip="#RRGGBB" AutomationProperties.Name="{L:Lan 前景色}"/><Button Tag="Foreground" Click="ChooseAppearanceColor" Width="40" Margin="8,0,0,0" ToolTip="{L:Lan 前景色}" AutomationProperties.Name="{L:Lan 前景色}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE790;"/></Button></StackPanel>
  <TextBlock x:Name="AppearanceError" Foreground="{DynamicResource Error}" TextWrapping="Wrap" Margin="0,16,0,0"/>
  <WrapPanel Margin="0,16,0,0">
<Button Click="ApplyAppearanceClick" Width="40" Margin="0,0,8,0" ToolTip="{L:Lan 应用}" AutomationProperties.Name="{L:Lan 应用}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8FB;"/></Button><Button Click="SaveAppearanceClick" Width="40" Margin="0,0,8,0" ToolTip="{L:Lan 保存主题}" AutomationProperties.Name="{L:Lan 保存主题}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;"/></Button><Button Click="ImportAppearanceClick" Width="40" Margin="0,0,8,0" ToolTip="{L:Lan 导入主题}" AutomationProperties.Name="{L:Lan 导入主题}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B5;"/></Button><Button Click="ExportAppearanceClick" Width="40" Margin="0,0,8,0" ToolTip="{L:Lan 导出主题}" AutomationProperties.Name="{L:Lan 导出主题}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE898;"/></Button><Button Click="ResetAppearanceClick" Width="40" Margin="0,0,8,0" ToolTip="{L:Lan 重置外观}" AutomationProperties.Name="{L:Lan 重置外观}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE777;"/></Button>
  </WrapPanel></StackPanel></Border>
 </StackPanel></ScrollViewer></TabItem>
  <TabItem Header="{L:Lan 教程}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top"><Frame HorizontalAlignment="Stretch" VerticalAlignment="Top" NavigationUIVisibility="Hidden" Source="/Pages/Setting/TutorialPage.xaml"/></ScrollViewer></TabItem>
  <TabItem Header="{L:Lan 关于}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top"><Frame HorizontalAlignment="Stretch" VerticalAlignment="Top" NavigationUIVisibility="Hidden" Source="/Pages/Setting/AboutPage.xaml"/></ScrollViewer></TabItem>
 </TabControl></DockPanel></Page>