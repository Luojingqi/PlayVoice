<Page x:Class="PlayVoice.Pages.Setting.SettingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:L="clr-namespace:PlayVoice.Resources.Language"
      xmlns:Hyperlink="clr-namespace:PlayVoice.Pages.Hyperlink"
      xmlns:Setting="clr-namespace:PlayVoice.Pages.Setting"
      mc:Ignorable="d">

 <Page.Resources>
  <Style x:Key="AppearanceRow" TargetType="Grid"><Setter Property="MinHeight" Value="58"/><Setter Property="Margin" Value="0,2"/></Style>
  <Style x:Key="AppearanceLabel" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,8,20,8"/></Style>
  <Style x:Key="AppearanceSlider" TargetType="Slider">
   <Setter Property="MinHeight" Value="36"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
    <Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
     <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="3" Background="{DynamicResource AccentColor}" CornerRadius="1.5"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb Width="16" Height="16"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{DynamicResource BgLight}" Stroke="{DynamicResource AccentColor}" StrokeThickness="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="3" Background="{DynamicResource Border}" CornerRadius="1.5"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
    </Track></Grid>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSurface}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Page.Resources>

 <DockPanel>
 <StackPanel DockPanel.Dock="Top" Margin="0,0,0,22"><TextBlock Text="{L:Lan 设置}" FontSize="{DynamicResource UiFontSize28}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/></StackPanel>
 <TabControl Style="{StaticResource StudioTabs}">
  <TabItem Header="{L:Lan 声卡绑定}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top"><StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Top"><Frame NavigationUIVisibility="Hidden" Source="/Pages/Setting/SoundCardBindingPage.xaml" Margin="0,0,0,16"/><Frame NavigationUIVisibility="Hidden" Source="/Pages/Setting/VirtualSoundCardInstallationPage.xaml"/></StackPanel></ScrollViewer></TabItem>
  <TabItem Header="{L:Lan 系统}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top"><Frame HorizontalAlignment="Stretch" VerticalAlignment="Top" NavigationUIVisibility="Hidden" Source="/Pages/Setting/SystemSettingsPage.xaml"/></ScrollViewer></TabItem>
<TabItem Header="{L:Lan 主题配色}"><DockPanel MaxWidth="960" HorizontalAlignment="Stretch"><DockPanel DockPanel.Dock="Top" Margin="0,0,0,16"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Click="ApplyAppearanceClick" Width="36" Height="36" Margin="6,0,0,0" Padding="0" ToolTip="{L:Lan 应用}" AutomationProperties.Name="{L:Lan 应用}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8FB;"/></Button><Button Click="SaveAppearanceClick" Width="36" Height="36" Margin="6,0,0,0" Padding="0" ToolTip="{L:Lan 保存主题}" AutomationProperties.Name="{L:Lan 保存主题}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;"/></Button><Button Click="ImportAppearanceClick" Width="36" Height="36" Margin="6,0,0,0" Padding="0" ToolTip="{L:Lan 导入主题}" AutomationProperties.Name="{L:Lan 导入主题}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B5;"/></Button><Button Click="ExportAppearanceClick" Width="36" Height="36" Margin="6,0,0,0" Padding="0" ToolTip="{L:Lan 导出主题}" AutomationProperties.Name="{L:Lan 导出主题}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE898;"/></Button><Button Click="ResetAppearanceClick" Width="36" Height="36" Margin="6,0,0,0" Padding="0" ToolTip="{L:Lan 重置外观}" AutomationProperties.Name="{L:Lan 重置外观}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE777;"/></Button></StackPanel><TextBlock Text="{L:Lan 主题配色}" FontWeight="SemiBold" FontSize="{DynamicResource UiFontSize16}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/></DockPanel><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,8,24"><Border Background="{DynamicResource BgLight}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Padding="20,8" Margin="0,0,0,16"><StackPanel><Grid Style="{StaticResource AppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{L:Lan 主题}" Style="{StaticResource AppearanceLabel}"/><ComboBox Grid.Column="1" x:Name="AppearanceChoices" Width="260" MinHeight="38" VerticalAlignment="Center" DisplayMemberPath="Name"/></Grid>
<Grid Style="{StaticResource AppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{L:Lan 强调色}" Style="{StaticResource AppearanceLabel}"/><WrapPanel Grid.Column="1" x:Name="PaletteChoices" VerticalAlignment="Center" MaxWidth="360"/></Grid>
<Grid Style="{StaticResource AppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{L:Lan 窗口材质}" Style="{StaticResource AppearanceLabel}"/><ComboBox Grid.Column="1" x:Name="MaterialChoices" Width="260" MinHeight="38" VerticalAlignment="Center" DisplayMemberPath="Name" SelectedValuePath="Key" AutomationProperties.Name="{L:Lan 窗口材质}"/></Grid>
<Grid Style="{StaticResource AppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{L:Lan 材质不透明度}" Style="{StaticResource AppearanceLabel}"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Slider x:Name="MaterialOpacityInput" Style="{StaticResource AppearanceSlider}" Minimum=".6" Maximum="1" TickFrequency=".02" IsSnapToTickEnabled="True" Width="196" AutomationProperties.Name="{L:Lan 材质不透明度}"/><TextBlock Text="{Binding Value, ElementName=MaterialOpacityInput, StringFormat={}{0:P0}}" Foreground="{DynamicResource TextSecondary}" Width="52" TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel></Grid>
<TextBlock Text="{L:Lan 系统材质说明}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,12"/></StackPanel></Border>
<Border Background="{DynamicResource BgLight}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Padding="20,8" Margin="0,0,0,16"><StackPanel><Grid Style="{StaticResource AppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{L:Lan 字体}" Style="{StaticResource AppearanceLabel}"/><ComboBox Grid.Column="1" x:Name="FontChoices" Width="260" MinHeight="38" VerticalAlignment="Center" /></Grid>
<Grid Style="{StaticResource AppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{L:Lan 界面字号}" Style="{StaticResource AppearanceLabel}"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Slider x:Name="FontSizeInput" Style="{StaticResource AppearanceSlider}" Minimum="11" Maximum="18" TickFrequency="1" IsSnapToTickEnabled="True" Width="196" AutomationProperties.Name="{L:Lan 界面字号}"/><TextBlock Text="{Binding Value, ElementName=FontSizeInput, StringFormat={}{0:0}}" Foreground="{DynamicResource TextSecondary}" Width="52" TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel></Grid>
</StackPanel></Border>
<Border Background="{DynamicResource BgLight}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Padding="20,8" Margin="0,0,0,16"><StackPanel><Grid Style="{StaticResource AppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{L:Lan 自定义主题}" Style="{StaticResource AppearanceLabel}"/><ComboBox Grid.Column="1" x:Name="CustomThemeChoices" Width="260" MinHeight="38" VerticalAlignment="Center" /></Grid>
<Grid Style="{StaticResource AppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{L:Lan 主题名称}" Style="{StaticResource AppearanceLabel}"/><TextBox Grid.Column="1" x:Name="ThemeNameInput" MaxLength="80" Width="260" VerticalAlignment="Center" AutomationProperties.Name="{L:Lan 主题名称}"/></Grid>
</StackPanel></Border>
<Expander Header="{L:Lan 自定义颜色}" IsExpanded="False" Margin="0,2,0,16"><StackPanel Margin="0,12,0,0"><Border Background="{DynamicResource BgLight}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Padding="20,8" Margin="0,0,0,16"><StackPanel><Grid Style="{StaticResource AppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{L:Lan 强调色}" Style="{StaticResource AppearanceLabel}"/><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="AccentInput" Width="216" MaxLength="7" ToolTip="#RRGGBB" AutomationProperties.Name="{L:Lan 强调色}"/><Button Tag="Accent" Click="ChooseAppearanceColor" Width="36" Height="36" Margin="8,0,0,0" Padding="0" ToolTip="{L:Lan 强调色}" AutomationProperties.Name="{L:Lan 强调色}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE790;"/></Button></StackPanel></Grid>
<Grid Style="{StaticResource AppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{L:Lan 背景色}" Style="{StaticResource AppearanceLabel}"/><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="BackgroundInput" Width="216" MaxLength="7" ToolTip="#RRGGBB" AutomationProperties.Name="{L:Lan 背景色}"/><Button Tag="Background" Click="ChooseAppearanceColor" Width="36" Height="36" Margin="8,0,0,0" Padding="0" ToolTip="{L:Lan 背景色}" AutomationProperties.Name="{L:Lan 背景色}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE790;"/></Button></StackPanel></Grid>
<Grid Style="{StaticResource AppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{L:Lan 前景色}" Style="{StaticResource AppearanceLabel}"/><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="ForegroundInput" Width="216" MaxLength="7" ToolTip="#RRGGBB" AutomationProperties.Name="{L:Lan 前景色}"/><Button Tag="Foreground" Click="ChooseAppearanceColor" Width="36" Height="36" Margin="8,0,0,0" Padding="0" ToolTip="{L:Lan 前景色}" AutomationProperties.Name="{L:Lan 前景色}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE790;"/></Button></StackPanel></Grid>
</StackPanel></Border>
</StackPanel></Expander><TextBlock x:Name="AppearanceError" Foreground="{DynamicResource Error}" TextWrapping="Wrap"/></StackPanel></ScrollViewer></DockPanel></TabItem>
  <TabItem Header="{L:Lan 教程}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top"><Frame HorizontalAlignment="Stretch" VerticalAlignment="Top" NavigationUIVisibility="Hidden" Source="/Pages/Setting/TutorialPage.xaml"/></ScrollViewer></TabItem>
  <TabItem Header="{L:Lan 关于}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top"><Frame HorizontalAlignment="Stretch" VerticalAlignment="Top" NavigationUIVisibility="Hidden" Source="/Pages/Setting/AboutPage.xaml"/></ScrollViewer></TabItem>
 </TabControl></DockPanel></Page>