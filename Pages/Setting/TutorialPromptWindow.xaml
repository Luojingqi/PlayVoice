<Window x:Class="PlayVoice.Pages.Setting.TutorialPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:L="clr-namespace:PlayVoice.Resources.Language"
        Width="420"
        Height="190"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="Transparent"
        Title="{L:Lan 教程提示}">

    <Window.Resources>
        <Style x:Key="ConfirmButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BgDark}"
            BorderBrush="{DynamicResource BgLight}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="58"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource Title}"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <TextBlock Text="{L:Lan 教程提示}"
                           Margin="11,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentColor}"
                           FontFamily="{StaticResource FontLight}"/>
            </Border>

            <TextBlock Grid.Row="1"
                       Margin="24,18,24,8"
                       Text="{L:Lan 教程提示_内容}"
                       Style="{StaticResource TextBlockLight}"
                       FontSize="15"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <Button Grid.Row="2"
                    Width="120"
                    Height="34"
                    Content="{L:Lan 确定}"
                    FontFamily="{StaticResource FontMedium}"
                    IsDefault="True"
                    Style="{StaticResource ConfirmButtonStyle}"
                    Click="ConfirmButton_OnClick"/>
        </Grid>
    </Border>
</Window>
