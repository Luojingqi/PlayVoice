<Window x:Class="PlayVoice.Pages.Setting.CloseBehaviorSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:L="clr-namespace:PlayVoice.Resources.Language"
        Width="380"
        Height="160"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="Transparent">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Style/Button.xaml"/>
                <ResourceDictionary Source="/Resources/Style/ListBox.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource BgDark}"
            BorderBrush="{DynamicResource BgLight}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource Title}"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="{L:Lan 关闭行为}"
                               Margin="11,0,40,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentColor}"
                               FontFamily="{StaticResource FontLight}"/>
                    <Button Content="╳"
                            Width="36"
                            HorizontalAlignment="Right"
                            Style="{StaticResource CloseButtonStyle}"
                            Click="CloseButton_OnClick"/>
                </Grid>
            </Border>

            <TextBlock Grid.Row="1"
                       Margin="18,10"
                       Text="{L:Lan 关闭 PlayVoice 时，希望如何处理？}"
                       Style="{StaticResource TextBlockLight}"
                       FontSize="15"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <ListBox Grid.Row="2"
                     x:Name="ActionListBox"
                     Width="270"
                     Height="32"
                     Tag="Uniform"
                     VerticalAlignment="Center"
                     Style="{StaticResource HorizontalButtonGroupStyle}"
                     SelectionChanged="ActionListBox_SelectionChanged">
                <ListBoxItem Style="{StaticResource GroupButtonItemStyle}">
                    <TextBlock Text="{L:Lan 直接关闭}"
                               Style="{StaticResource TextBlockLight}"/>
                </ListBoxItem>
                <ListBoxItem Style="{StaticResource GroupButtonItemStyle}">
                    <TextBlock Text="{L:Lan 最小化到托盘}"
                               Style="{StaticResource TextBlockLight}"/>
                </ListBoxItem>
            </ListBox>
        </Grid>
    </Border>
</Window>
