<UserControl x:Class="PlayVoice.Pages.Loading.AudioFileProgressOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:L="clr-namespace:PlayVoice.Resources.Language"
             Visibility="Collapsed">
    <UserControl.Resources>
        <Style x:Key="StopButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{DynamicResource FontMedium}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Background="Transparent"
            CornerRadius="5">
        <Border Width="420"
                Padding="24,20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource BgDark}"
                BorderBrush="{DynamicResource AccentColor}"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel>
                <TextBlock x:Name="TitleText"
                           Style="{StaticResource TextBlockMedium}"
                           FontSize="{DynamicResource UiFontSize18}"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="FileNameText"
                           Margin="0,12,0,10"
                           Style="{StaticResource TextBlockLight}"
                           FontSize="{DynamicResource UiFontSize13}"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <Grid x:Name="ProgressTrack"
                      Height="8"
                      Background="{DynamicResource BgLight}"
                      ClipToBounds="True">
                    <Border Width="{Binding ElementName=ProgressTrack, Path=ActualWidth}"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource AccentColor}"
                            RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ProgressScale" ScaleX="0"/>
                        </Border.RenderTransform>
                    </Border>
                </Grid>
                <TextBlock x:Name="ProgressText"
                           Margin="0,8,0,0"
                           Style="{StaticResource TextBlockLight}"
                           FontSize="{DynamicResource UiFontSize13}"
                           HorizontalAlignment="Center"/>
                <Button x:Name="StopButton"
                        Width="120"
                        Height="32"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"

                        Style="{StaticResource StopButtonStyle}"
                        Click="StopButton_Click" ToolTip="{L:Lan 停止加载}" AutomationProperties.Name="{L:Lan 停止加载}"><TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="16"/></Button>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
