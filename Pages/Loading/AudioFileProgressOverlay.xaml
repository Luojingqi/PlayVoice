<UserControl x:Class="PlayVoice.Pages.Loading.AudioFileProgressOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <Border Background="Transparent"
            CornerRadius="5">
        <Border Width="420"
                Padding="24,20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource BgDark}"
                BorderBrush="{DynamicResource AccentColor}"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel>
                <TextBlock x:Name="TitleText"
                           Style="{StaticResource TextBlockMedium}"
                           FontSize="18"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="FileNameText"
                           Margin="0,12,0,10"
                           Style="{StaticResource TextBlockLight}"
                           FontSize="13"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <Grid x:Name="ProgressTrack"
                      Height="8"
                      Background="{DynamicResource BgLight}"
                      ClipToBounds="True">
                    <Border Width="{Binding ElementName=ProgressTrack, Path=ActualWidth}"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource AccentColor}"
                            RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ProgressScale" ScaleX="0"/>
                        </Border.RenderTransform>
                    </Border>
                </Grid>
                <TextBlock x:Name="ProgressText"
                           Margin="0,8,0,0"
                           Style="{StaticResource TextBlockLight}"
                           FontSize="13"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
