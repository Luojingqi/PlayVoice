<Page x:Class="PlayVoice.Pages.FunctionPreset.DeleteFunctionPresetPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:L="clr-namespace:PlayVoice.Resources.Language"
      mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Style/ListBox.xaml"/>
                <ResourceDictionary Source="/Resources/Style/ComboBox.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Border
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Background="{DynamicResource AccentSurfaceSubtle}" BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       Style="{StaticResource TextBlockMedium}"
                       Text="{L:Lan 删除游戏预设}"
                       FontSize="{DynamicResource UiFontSize18}"
                       Margin="0,0,0,10"
                       TextAlignment="Left"/>
            <ComboBox Grid.Row="1"
                      x:Name="FunctionPresetComboBox"
                      DisplayMemberPath="DisplayName"
                      Width="260" HorizontalAlignment="Left"
                      Height="38"
                      Margin="0,5"
                      Style="{StaticResource TransparentComboBoxStyle}"/>
            <ListBox Grid.Row="2"
                     x:Name="ButtonGroupListBox"
                     Tag="Uniform"
                     Width="120" HorizontalAlignment="Left"
                     Margin="0,5"
                     Style="{StaticResource HorizontalButtonGroupStyle}">
                <ListBoxItem Style="{StaticResource GroupButtonItemStyle}" ToolTip="{L:Lan 删除}" AutomationProperties.Name="{L:Lan 删除}">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextPrimary}"/>
                </ListBoxItem>
            </ListBox>
        </Grid>
    </Border>
</Page>
