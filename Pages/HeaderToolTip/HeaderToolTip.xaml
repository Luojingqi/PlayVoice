<UserControl x:Class="PlayVoice.Pages.HeaderToolTip.HeaderToolTip"
             x:Name="self"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="HeaderPanel"
            VerticalAlignment="Center"
            HorizontalAlignment="Left"
            Margin="-4,-3"
            Padding="4,3"
            Background="Transparent"
            Tag="{Binding ToolTipText, ElementName=self}"
            ToolTipService.InitialShowDelay="180"
            ToolTipOpening="HeaderPanel_ToolTipOpening">
        <Border.ToolTip>
            <ToolTip Style="{StaticResource {x:Type ToolTip}}">
                <TextBlock Text="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ToolTip}}"
                           MaxWidth="420"
                           TextWrapping="Wrap"/>
            </ToolTip>
        </Border.ToolTip>
        <Border.Triggers>
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="HelpIconScale"
                                         Storyboard.TargetProperty="ScaleX"
                                         To="1.18"
                                         Duration="0:0:0.18"/>
                        <DoubleAnimation Storyboard.TargetName="HelpIconScale"
                                         Storyboard.TargetProperty="ScaleY"
                                         To="1.18"
                                         Duration="0:0:0.18"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="HelpIconScale"
                                         Storyboard.TargetProperty="ScaleX"
                                         To="1"
                                         Duration="0:0:0.12"/>
                        <DoubleAnimation Storyboard.TargetName="HelpIconScale"
                                         Storyboard.TargetProperty="ScaleY"
                                         To="1"
                                         Duration="0:0:0.12"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left">

        <TextBlock Text="{Binding Header, ElementName=self}"
                   Style="{StaticResource TextBlockLight}"
                   VerticalAlignment="Center"
                   FontSize="{Binding HeaderFontSize, ElementName=self}"
                   TextAlignment="Left"/>
        <Border Width="13"
                Height="13"
                Margin="5,0,0,0"
                VerticalAlignment="Center"
                BorderBrush="{DynamicResource TextSecondary}"
                BorderThickness="1"
                CornerRadius="6.5"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="HelpIconScale"/>
            </Border.RenderTransform>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToolTipText, ElementName=self}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ToolTipText, ElementName=self}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="?"
                       Foreground="{DynamicResource TextSecondary}"
                       FontFamily="{DynamicResource FontMedium}"
                       FontSize="9"
                       LineHeight="11"
                       TextAlignment="Center"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
        </Border>
        </StackPanel>
    </Border>
</UserControl>
