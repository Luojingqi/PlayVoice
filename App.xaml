<Application x:Class="PlayVoice.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Style/ScrollBar.xaml"/>
                <ResourceDictionary Source="/Resources/Style/ToolTipBorder.xaml"/>
            <ResourceDictionary Source="/Resources/Style/ComboBox.xaml"/><ResourceDictionary Source="/Resources/Style/DesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="FontHeavy">Segoe UI, Microsoft YaHei UI</FontFamily>
            <FontFamily x:Key="FontMedium">Segoe UI, Microsoft YaHei UI</FontFamily>
            <FontFamily x:Key="FontLight">Segoe UI, Microsoft YaHei UI</FontFamily>

            <Style TargetType="TextBlock" x:Key="TextBlockHeavy">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="FontFamily" Value="{DynamicResource FontHeavy}"/>
            </Style>
            <Style TargetType="TextBlock" x:Key="TextBlockMedium">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="FontFamily" Value="{DynamicResource FontMedium}"/>
            </Style>
            <Style TargetType="TextBlock" x:Key="TextBlockLight">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="FontFamily" Value="{DynamicResource FontLight}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

